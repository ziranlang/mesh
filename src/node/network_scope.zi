#import "std/go_types"
net :: #import "std/net_go";
addresses :: #import "network_address";
http :: #import "std/http_go";
ctx :: #import "std/context_go";
clock :: #import "std/time_go";
errors :: #import "std/errors_go";
wire_text :: #import "wire_text";
go_net :: #system_library "go:net";
go_http :: #system_library "go:net/http";
go_native :: #system_library "go:mesh/native";
go_strings :: #system_library "go:strings";
builtin :: #system_library "go:builtin";

NetworkScope :: struct {
    LANOnly: bool
    Networks: []string
}
NetworkMiddleware :: struct {
    scope: NetworkScope
    next: NetworkHandler
}
ScopedDialer :: struct {
    scope: NetworkScope
}
NetworkHandler :: #type #foreign go_http "Handler";
IPNetwork :: #type #foreign go_net "IPNet";
Connection :: #type #foreign go_net "Conn";
SocketDialer :: #type #foreign go_net "Dialer";
HTTPTransport :: #type #foreign go_http "Transport";
IPAddress :: #type #foreign go_net "IPAddr";
DNSResolver :: #type #foreign go_net "Resolver";
InterfaceAddress :: #type #foreign go_net "Addr";
NetworkParseResult :: struct { ip: net.IP; network: *IPNetwork; error: Error; }
ConnectionResult :: struct { value: Connection; error: Error; }
AddressesResult :: struct { value: []IPAddress; error: Error; }
InterfaceAddressesResult :: struct { value: []InterfaceAddress; error: Error; }
TransportDialer :: #type #foreign go_native "ContextDialer";
NetworkRedirect :: #type (request: *http.Request, previous: []*http.Request) -> Error;

#scope_export
ParseCIDRRaw :: (value: string) -> NetworkParseResult #go_results #foreign go_net "ParseCIDR";
ContainsRaw :: (network: *IPNetwork, ip: net.IP) -> bool #foreign go_net "(*IPNet).Contains";
Mask :: (network: *IPNetwork) -> []u8 #go_field #foreign go_net "(*IPNet).Mask";
NetworkIPRaw :: (network: *IPNetwork) -> net.IP #go_field #foreign go_net "(*IPNet).IP";
#scope_file
JoinHostPort :: (host: string, port: string) -> string #foreign go_net;
DefaultResolver :: () -> *DNSResolver #go_field #foreign go_net "DefaultResolver";
InterfaceAddresses :: () -> InterfaceAddressesResult #go_results #foreign go_net "InterfaceAddrs";
InterfaceString :: (address: InterfaceAddress) -> string #foreign go_net "Addr.String";
Lookup :: (resolver: *DNSResolver, context: ctx.Context, host: string) -> AddressesResult #go_results #foreign go_net "(*Resolver).LookupIPAddr";
AddressIP :: (address: IPAddress) -> net.IP #go_field #foreign go_net "(IPAddr).IP";
AddressString :: (address: *IPAddress) -> string #foreign go_net "(*IPAddr).String";
AllocateDialer :: () -> *SocketDialer #foreign builtin "new";
DialRaw :: (dialer: *SocketDialer, context: ctx.Context, network: string, address: string) -> ConnectionResult #go_results #foreign go_net "(*Dialer).DialContext";
AllocateTransport :: () -> *HTTPTransport #foreign builtin "new";
AllocateScopedDialer :: () -> *ScopedDialer #foreign builtin "new";
SetDial :: (transport: *HTTPTransport, dialer: TransportDialer) #foreign go_native "InstallDial";
SetTransport :: (client: *http.Client, transport: *HTTPTransport) #go_field #foreign go_http "(*Client).Transport";
SetRedirect :: (client: *http.Client, callback: NetworkRedirect) #go_field #foreign go_http "(*Client).CheckRedirect";
LastResponse :: () -> Error #go_field #foreign go_http "ErrUseLastResponse";
AllocateMiddleware :: () -> *NetworkMiddleware #foreign builtin "new";
Serve :: (handler: NetworkHandler, writer: http.ResponseWriter, request: *http.Request) #foreign go_http "Handler.ServeHTTP";
Split :: (value: string, separator: string) -> []string #foreign go_strings;

#scope_export
ParseCIDR :: (value: string) -> NetworkParseResult {
    return ParseCIDRRaw(value)
}

Contains :: (network: *IPNetwork, ip: net.IP) -> bool {
    return ContainsRaw(network, ip)
}

NetworkIP :: (network: *IPNetwork) -> net.IP {
    return NetworkIPRaw(network)
}

ParseNetworks :: (value: string) -> []string {
    result: []string
    if value == "" {
        return result
    }
    result = Split(value, ",")
    index: s64 = 0
    while index < result.count {
        result[index] = wire_text.TrimSpace(result[index])
        index += 1
    }
    return result
}

ValidNetworks :: (networks: []string) -> bool {
    if networks.count == 0 {
        return false
    }
    for value: networks {
        if !PrivateRange(value) {
            return false
        }
    }
    return true
}

PrivateRange :: (value: string) -> bool {
    candidate := ParseCIDR(value)
    if candidate.error != null || candidate.network == null {
        return false
    }
    return addresses.IsLocalRange(cast([]u8)NetworkIP(candidate.network), Mask(candidate.network))
}

Narrower :: (child: *IPNetwork, parent: *IPNetwork) -> bool {
    return addresses.MaskContains(Mask(parent), Mask(child))
}

AllowsIP :: (scope: NetworkScope, ip: net.IP) -> bool {
    if !scope.LANOnly {
        return true
    }
    classification := addresses.Classify(cast([]u8)ip)
    if classification == addresses.AddressClass.Loopback {
        return true
    }
    if classification == addresses.AddressClass.Other {
        return false
    }
    for value: scope.Networks {
        parsed := ParseCIDR(value)
        if parsed.error == null && Contains(parsed.network, ip) {
            return true
        }
    }
    return false
}

AllowsAddress :: (scope: NetworkScope, address: string) -> bool {
    split := net.SplitHostPort(address)
    if split.error != null {
        return false
    }
    host := Split(split.host, "%")
    return AllowsIP(scope, net.ParseIP(host[0]))
}

Validate :: (scope: NetworkScope, address: string) -> Error {
    if !scope.LANOnly {
        return null
    }
    if !ValidNetworks(scope.Networks) || !AllowsAddress(scope, address) {
        return errors.New("LAN-only nodes require explicit private LAN networks and a local bind address")
    }
    local := InterfaceAddresses()
    if local.error != null {
        return local.error
    }
    for declared: scope.Networks {
        child := ParseCIDR(declared)
        connected := false
        for interface: local.value {
            parent := ParseCIDR(InterfaceString(interface))
            if parent.error == null && Contains(parent.network, NetworkIP(child.network)) && Narrower(child.network, parent.network) {
                connected = true
            }
        }
        if !connected {
            return errors.New("LAN network is not within a connected local subnet")
        }
    }
    return null
}

Wrap :: (scope: NetworkScope, next: NetworkHandler) -> NetworkHandler {
    if !scope.LANOnly {
        return next
    }
    value := AllocateMiddleware()
    value.scope = scope
    value.next = next
    return cast(NetworkHandler)value
}

ServeHTTP :: (middleware: *NetworkMiddleware, writer: http.ResponseWriter, request: *http.Request) #go_method "ServeHTTP" {
    if !AllowsAddress(middleware.scope, http.RemoteAddress(request)) {
        http.WriteHeader(writer, cast(isize)403)
        return
    }
    Serve(middleware.next, writer, request)
}

NoRedirect :: (request: *http.Request, previous: []*http.Request) -> Error {
    return LastResponse()
}

DialContext :: (scoped: *ScopedDialer, context: ctx.Context, network: string,
    address: string) -> ConnectionResult #go_method "DialContext" #go_results {
    result: ConnectionResult
    split := net.SplitHostPort(address)
    if split.error != null {
        return .{error = split.error}
    }
    // Resolve once, reject mixed/public answers, and dial the numeric result.
    // The HTTP URL remains unchanged for TLS hostname verification.
    resolved := Lookup(DefaultResolver(), context, split.host)
    if resolved.error != null {
        return .{error = resolved.error}
    }
    for ip: resolved.value {
        if !AllowsIP(scoped.scope, AddressIP(ip)) {
            return .{error = errors.New("peer is outside the node LAN")}
        }
    }
    if resolved.value.count == 0 {
        return .{error = errors.New("peer has no LAN address")}
    }
    dialer := AllocateDialer()
    for ip: resolved.value {
        result = DialRaw(dialer, context, network, JoinHostPort(AddressString(*ip), split.port))
        if result.error == null {
            return result
        }
    }
    return result
}

Client :: (scope: NetworkScope, timeout: clock.Duration) -> *http.Client {
    client := http.NewClient(timeout)
    if scope.LANOnly {
        transport := AllocateTransport()
        dialer := AllocateScopedDialer()
        dialer.scope = scope
        SetDial(transport, cast(TransportDialer)dialer)
        SetTransport(client, transport)
        SetRedirect(client, NoRedirect)
    }
    return client
}
