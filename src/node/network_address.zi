AddressClass :: enum s32 { Other; Loopback; Private; LinkLocal }

#scope_file
LocalPrefix :: struct {
    classification: AddressClass
    bits: s64
}

HasZeros :: (bytes: []u8) -> bool {
    for byte: bytes {
        if byte != 0 { return false }
    }
    return true
}

Describe :: (address: []u8) -> LocalPrefix {
    if address.count == 4 {
        first := address[0]
        second := address[1]
        if first == 127 { return .{classification = .Loopback, bits = 8} }
        if first == 10 { return .{classification = .Private, bits = 8} }
        if first == 172 && second >= 16 && second <= 31 { return .{classification = .Private, bits = 12} }
        if first == 192 && second == 168 { return .{classification = .Private, bits = 16} }
        if first == 169 && second == 254 { return .{classification = .LinkLocal, bits = 16} }
    } else if address.count == 16 {
        if address[15] == 1 && HasZeros(address[:15]) { return .{classification = .Loopback, bits = 128} }
        if (address[0] & 254) == 252 { return .{classification = .Private, bits = 7} }
        if address[0] == 254 && (address[1] & 192) == 128 { return .{classification = .LinkLocal, bits = 10} }
    }
    return .{}
}

#scope_export
// Addresses are network-order bytes. Treat an IPv4-mapped host as IPv4.
Classify :: (address: []u8) -> AddressClass {
    if address.count == 16 && address[10] == 255 && address[11] == 255 && HasZeros(address[:10]) {
        return Describe(address[12:]).classification
    }
    return Describe(address).classification
}

// A parsed CIDR must stay inside a local prefix of its own address family.
IsLocalRange :: (network: []u8, mask: []u8) -> bool {
    required := Describe(network).bits
    if required == 0 || network.count != mask.count { return false }
    whole := required / 8
    index: s64 = 0
    while index < whole {
        if mask[index] != 255 { return false }
        index += 1
    }
    rest := required % 8
    if rest == 0 { return true }
    partial := cast(u8)(cast(u32)255 << cast(u32)(8 - rest))
    return (mask[whole] & partial) == partial
}

MaskContains :: (parent: []u8, child: []u8) -> bool {
    if parent.count != child.count { return false }
    for byte, index: parent {
        if (child[index] & byte) != byte { return false }
    }
    return true
}
