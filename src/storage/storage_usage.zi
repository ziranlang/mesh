// Transactional billable storage totals. Basic tracking never consumes an
// account allowance; custom text, media and documents retain their charges.
#import "std/go_types"
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
native :: #system_library "go:database/sql";
schema :: #import "storage_usage_schema";
errors :: #import "std/errors_go";
#import "std/vec"

#scope_file
RollbackAtReturn :: (transaction: *sql.Transaction) #go_defer #foreign native "(*Tx).Rollback";

#scope_export
Ensure :: (database: *sql.Database, context: ctx.Context) -> Error {
    empty: [0]Any
    // REPLACE must run its delete triggers too, including on a new connection.
    configured := sql.Exec(database, context, "PRAGMA recursive_triggers=ON", empty[:])
    if configured.error != null {
        return configured.error
    }
    opened := sql.Begin(database, context, null)
    if opened.error != null {
        return opened.error
    }
    transaction := opened.value
    RollbackAtReturn(transaction)
    tables: s32
    destinations: [1]Any = .[*tables]
    error := sql.ScanRow(sql.QueryRowTx(transaction, context,
        schema.ExistingTables, empty[:]), destinations[:])
    if error != null {
        return error
    }
    version: s32
    if tables == 2 {
        versions: [1]Any = .[*version]
        error = sql.ScanRow(sql.QueryRowTx(transaction, context,
            schema.ExistingVersion, empty[:]), versions[:])
        if error != null {
            return error
        }
    }
    if version > schema.Version {
        // A downgraded binary must not overwrite a newer accounting schema.
        return sql.Commit(transaction)
    }
    if version != schema.Version {
        // CREATE IF NOT EXISTS cannot replace old accounting expressions.
        // Rebuild all owned triggers and totals together in this transaction.
        drops := schema.DropTriggers()
        if drops.count == 0 { return errors.New("could not build storage accounting migration") }
        removed := sql.ExecTx(transaction, context, TextView(VecSlice(drops, 0, drops.count)), empty[:])
        if removed.error != null { return removed.error }
    }
    triggers := schema.Build()
    if triggers.count == 0 { return errors.New("could not build storage accounting schema") }
    created := sql.ExecTx(transaction, context, TextView(VecSlice(triggers, 0, triggers.count)), empty[:])
    if created.error != null {
        return created.error
    }
    if version != schema.Version {
        backfill := schema.Backfill()
        if backfill.count == 0 { return errors.New("could not build storage accounting backfill") }
        filled := sql.ExecTx(transaction, context, TextView(VecSlice(backfill, 0, backfill.count)), empty[:])
        if filled.error != null {
            return filled.error
        }
        versions: [1]Any = .[schema.Version]
        recorded := sql.ExecTx(transaction, context,
            schema.WriteVersion, versions[:])
        if recorded.error != null {
            return recorded.error
        }
    }
    return sql.Commit(transaction)
}

Reconcile :: (database: *sql.Database, context: ctx.Context, user: string) -> Error {
    arguments: [1]Any = .[user]
    statement := schema.Reconcile()
    if statement.count == 0 { return errors.New("could not build storage accounting reconciliation") }
    written := sql.Exec(database, context, TextView(VecSlice(statement, 0, statement.count)), arguments[:])
    return written.error
}
