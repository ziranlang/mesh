#import "std/go_types"
errors :: #import "std/errors_go";
filepath :: #system_library "go:path/filepath";
strings :: #system_library "go:strings";

#scope_file
IsLocal :: (path: string) -> bool #foreign filepath;
ContainsAny :: (value: string, characters: string) -> bool #foreign strings;
ContainsNul :: (value: string, character: s32) -> bool #foreign strings "ContainsRune";

#scope_export
ComponentResult :: struct {
    value: string
    error: Error
}

// Only a single, unchanged name may address a stored object.
Validate :: (value: string) -> ComponentResult {
    if !IsLocal(value) || value == "." || ContainsAny(value, "/\\") || ContainsNul(value, 0) {
        return .{error = errors.New("invalid filesystem component")}
    }
    return .{value = value}
}
