#import "std/go_types"
#import "std/vec"
features :: #import "schema_features";
history :: #import "schema_history";
sql :: #import "std/sql_go";
definitions_sql :: #import "schema_sql";
ctx :: #import "std/context_go";
errors :: #import "std/errors_go";
native :: #system_library "go:database/sql";
strings :: #system_library "go:strings";

#scope_file
MeditationKeysResult :: struct {
    userKey: isize
    idKey: isize
    error: Error
}
CloseRowsAtReturn :: (rows: *sql.Rows) #go_defer #foreign native "(*Rows).Close";
Contains :: (value: string, part: string) -> bool #foreign strings;
Join :: (values: []string, separator: string) -> string #foreign strings;

ReadMeditationKeys :: (rows: *sql.Rows) -> MeditationKeysResult {
    result: MeditationKeysResult
    CloseRowsAtReturn(rows)
    while sql.Next(rows) {
        cid: isize
        name: string
        type: string
        notNull: isize
        defaultValue: sql.NullString
        key: isize
        destinations: [6]Any = .[*cid, *name, *type, *notNull, *defaultValue, *key]
        result.error = sql.ScanRows(rows, destinations[:])
        if result.error != null {
            sql.CloseRows(rows)
            return result
        }
        if name == "user_id_hash" {
            result.userKey = key
        } else if name == "id" {
            result.idKey = key
        }
    }
    // The released migration checks Close rather than Err after iteration.
    result.error = sql.CloseRows(rows)
    return result
}

#scope_export
AddColumn :: (database: *sql.Database, context: ctx.Context, table: string,
    column: string, ddl: string) -> Error {
    arguments: [2]Any = .[table, column]
    queried := sql.Query(database, context, definitions_sql.ColumnLookup, arguments[:])
    if queried.error != null {
        return queried.error
    }
    rows := queried.value
    CloseRowsAtReturn(rows)
    if sql.Next(rows) {
        return null
    }
    error := sql.RowsError(rows)
    if error != null {
        return error
    }
    empty: [0]Any
    written := sql.Exec(database, context, ddl, empty[:])
    return written.error
}

MeshColumns :: (database: *sql.Database, context: ctx.Context) -> Error {
    error := AddColumn(database, context, "server_mesh_changes", "op", definitions_sql.MeshOperationColumn)
    if error != null {
        return error
    }
    return AddColumn(database, context, "server_mesh_changes", "deleted_at", definitions_sql.MeshDeletionColumn)
}

// Plans bought before sizes existed are 1 GB.
StorageSizes :: (database: *sql.Database, context: ctx.Context) -> Error {
    error := AddColumn(database, context, "server_storage_plans", "size", definitions_sql.StoragePlanSize)
    if error != null {
        return error
    }
    return AddColumn(database, context, "server_storage_purchases", "size", definitions_sql.StoragePurchaseSize)
}

MeditationKey :: (database: *sql.Database, context: ctx.Context) -> Error {
    empty: [0]Any
    queried := sql.Query(database, context, definitions_sql.MeditationInfo, empty[:])
    if queried.error != null {
        return queried.error
    }
    keys := ReadMeditationKeys(queried.value)
    if keys.error != null {
        return keys.error
    }
    if keys.userKey == cast(isize)1 && keys.idKey == cast(isize)2 {
        return null
    }
    written := sql.Exec(database, context, definitions_sql.MeditationUpgrade, empty[:])
    if written.error != null {
        sql.Exec(database, context, definitions_sql.MeditationRollback, empty[:])
        return written.error
    }
    return null
}

SocialCache :: (database: *sql.Database, context: ctx.Context) -> Error {
    empty: [0]Any
    exists: isize
    destinations: [1]Any = .[*exists]
    row := sql.QueryRow(database, context, definitions_sql.SocialExists, empty[:])
    error := sql.ScanRow(row, destinations[:])
    if error != null || exists == cast(isize)0 {
        return error
    }
    written := sql.Exec(database, context, definitions_sql.SocialUpgrade, empty[:])
    return written.error
}

Ensure :: (database: *sql.Database, context: ctx.Context) -> Error {
    empty: [0]Any
    pragmas := sql.Exec(database, context, definitions_sql.Pragmas, empty[:])
    if pragmas.error != null {
        return pragmas.error
    }
    historic := history.Build()
    if historic.count == 0 {
        return errors.New("could not build state history schema")
    }
    tableDefinitions := definitions_sql.Tables()
    featureDefinitions := features.Statements(TextView(VecSlice(historic, 0, historic.count)))
    definitions: [2]string = .[Join(tableDefinitions[:], ""), Join(featureDefinitions[:], "")]
    created := sql.Exec(database, context, Join(definitions[:], ""), empty[:])
    if created.error != null {
        return created.error
    }
    backfilled := sql.Exec(database, context, definitions_sql.BackfillMesh, empty[:])
    if backfilled.error != null {
        return backfilled.error
    }
    error := MeshColumns(database, context)
    if error != null {
        return error
    }
    error = MeditationKey(database, context)
    if error != null {
        return error
    }
    error = SocialCache(database, context)
    if error != null {
        return error
    }
    upgrades := definitions_sql.Upgrades()
    for statement: upgrades {
        written := sql.Exec(database, context, statement, empty[:])
        if written.error != null && !Contains(errors.Message(written.error), "duplicate column") {
            return written.error
        }
    }
    indexed := sql.Exec(database, context, definitions_sql.AliasIndex, empty[:])
    if indexed.error != null {
        return indexed.error
    }
    indexes := definitions_sql.Indexes()
    for statement: indexes {
        written := sql.Exec(database, context, statement, empty[:])
        if written.error != null {
            return written.error
        }
    }
    return null
}
