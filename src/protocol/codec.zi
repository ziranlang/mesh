#import "std/vec"
binary :: #import "binary_codec";

BinaryField :: struct {
    value: string
    error: string
}

mlDSA44PublicKeySize :: 1312;
mlDSA44PrivateKeySize :: 2560;
mlDSA44SignatureSize :: 2420;

#scope_file
// The existing Go ABI uses strings for arbitrary binary data. Native callers
// use binary_codec to keep ownership of the bytes in the returned Vec.
ToString :: (result: binary.BinaryBytes) -> BinaryField {
    if result.error != "" {
        return .{error = result.error}
    }
    bytes := result.value
    return .{value = BuilderFinish(bytes)}
}

#scope_export
IsHex :: (value: string) -> bool {
    return binary.IsHex(value)
}

DecodeBase64 :: (value: string, url: bool, padded: bool) -> BinaryField {
    return ToString(binary.DecodeBase64(value, url, padded))
}

DecodeBinaryField :: (input: string) -> BinaryField {
    return ToString(binary.DecodeBinaryField(input))
}

EncodeBase64 :: (value: string, url: bool, padded: bool) -> BinaryField {
    return ToString(binary.EncodeBase64(value, url, padded))
}
