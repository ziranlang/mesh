utf8 :: #import "std/utf8";
tools :: #import "std/text_tools";

CutResult :: struct {
    before: string
    after: string
    found: bool
}

TokenEqual :: #type (value: string, token: string) -> bool;

// The caller supplies a valid byte offset. Decode a short window so the UTF-8 offset stays within its 32-bit type.
WhitespaceWidth :: (input: string, at: s64) -> s64 {
    byte := input[at]
    if byte < 128 {
        if byte == 32 || (byte >= 9 && byte <= 13) {
            return 1
        }
        return 0
    }
    end := at + 4
    if end > input.count {
        end = input.count
    }
    decoded := utf8.Decode(input[at:end], 0)
    point := decoded.value
    if point == 0x85 || point == 0xA0 || point == 0x1680 ||
       (point >= 0x2000 && point <= 0x200A) || point == 0x2028 ||
       point == 0x2029 || point == 0x202F || point == 0x205F || point == 0x3000 {
        return cast(s64)decoded.after
    }
    return 0
}

TrimPrefix :: (input: string, prefix: string) -> string {
    if tools.TextHasPrefix(input, prefix) {
        return input[prefix.count:]
    }
    return input
}

// Split at the first separator. The pieces borrow the input bytes.
Cut :: (value: string, separator: u8) -> CutResult {
    index: s64 = 0
    while index < value.count {
        if value[index] == separator {
            return .{before = value[:index], after = value[index + 1:], found = true}
        }
        index += 1
    }
    return .{before = value}
}

ContainsToken :: (header: string, token: string, equal: TokenEqual) -> bool {
    remaining := header
    while true {
        part := Cut(remaining, #char ",")
        if equal(TrimSpace(part.before), token) { return true }
        if !part.found { return false }
        remaining = part.after
    }
}

// The released wire parsers trim Unicode White_Space and retain malformed bytes.
TrimSpace :: (input: string) -> string {
    start: s64 = 0
    while start < input.count {
        width := WhitespaceWidth(input, start)
        if width == 0 {
            break
        }
        start += width
    }
    end := input.count
    while end > start {
        last := end - 1
        while last > start && end - last < 4 && input[last] >= 128 && input[last] <= 191 {
            last -= 1
        }
        if WhitespaceWidth(input[:end], last) != end - last {
            break
        }
        end = last
    }
    return input[start:end]
}

// Compare with a lowercase ASCII token using Unicode simple case folding, as
// the released parser did. Only ſ and K fold to ASCII from outside ASCII.
MatchesToken :: (input: string, lower: string) -> bool {
    at: s64 = 0
    for expected: lower {
        if at == input.count {
            return false
        }
        byte := input[at]
        if byte >= 65 && byte <= 90 {
            byte += 32
        }
        if byte == expected {
            at += 1
        } else if expected == 115 && input.count - at >= 2 && input[at:at + 2] == "ſ" {
            at += 2
        } else if expected == 107 && input.count - at >= 3 && input[at:at + 3] == "K" {
            at += 3
        } else {
            return false
        }
    }
    return at == input.count
}
