#import "std/map_go"

wire_text :: #import "wire_text";
go_strings :: #system_library "go:strings";
ToLower :: (value: string) -> string #foreign go_strings;

StringSet :: Map(string, bool)

FromEnvironment :: (raw: string) -> StringSet {
    result: StringSet
    MapInit(result)
    remaining := raw
    while remaining != "" {
        part := wire_text.Cut(remaining, #char ",")
        item := wire_text.TrimSpace(part.before)
        if item != "" {
            MapSet(result, item, true)
        }
        remaining = part.after
    }
    return result
}

Normalize :: (values: []string) -> StringSet {
    result: StringSet
    MapInit(result)
    for value: values {
        item := ToLower(wire_text.TrimSpace(value))
        if item != "" {
            MapSet(result, item, true)
        }
    }
    return result
}
