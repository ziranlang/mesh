#import "identity"
#import "protocol"
#import "std/vec"
text :: #import "std/text_tools";
wire_text :: #import "wire_text";

ValidAppVisibility :: (value: string) -> bool {
    return value == "private" || value == "shared" || value == "friends" || value == "public"
}

ValidLegacyProtocolStatus :: (value: string) -> bool {
    return value == "compatibility" || value == "deprecated" || value == "active"
}

ValidTokenPolicyPermission :: (value: string) -> bool {
    return value == "spend" || value == "purchase"
}

ValidCollectionPrefix :: (input: string) -> bool {
    value := wire_text.TrimSpace(input)
    if value == "" {
        return false
    }
    if ValidLegacyEncryptedCollection(value) {
        return true
    }
    if text.TextHasSuffix(value, ".*") {
        return ValidCollectionPrefixWildcardBase(value[:value.count - 2])
    }
    return ValidEncryptedHierarchyCollection(value)
}

ValidCollectionPrefixWildcardBase :: (value: string) -> bool {
    visibility := wire_text.Cut(wire_text.TrimSpace(value), #char ".")
    if !visibility.found {
        return false
    }
    if visibility.before == "account" {
        return ValidVersionSegment(visibility.after)
    }
    app := wire_text.Cut(visibility.after, #char ".")
    version := wire_text.Cut(app.after, #char ".")
    if !ValidAppVisibility(visibility.before) || !app.found ||
        !ValidNamespaceSegment(app.before) || !ValidVersionSegment(version.before) {
        return false
    }
    remaining := version
    while remaining.found {
        remaining = wire_text.Cut(remaining.after, #char ".")
        if !ValidNamespaceSegment(remaining.before) {
            return false
        }
    }
    return true
}

// The app whose data a collection holds: the app segment of a namespaced
// collection, Inbe for its released v4 names, or "" for account-wide and older
// names that no app scope claims.
CollectionOwnerApp :: (collection: string) -> string {
    value := wire_text.TrimSpace(collection)
    if ValidLegacyEncryptedCollection(value) {
        return "inbe"
    }
    visibility := wire_text.Cut(value, #char ".")
    app := wire_text.Cut(visibility.after, #char ".")
    if app.found && ValidAppVisibility(visibility.before) {
        return app.before
    }
    return ""
}

AppOwnsDeclaredScope :: (appID: string, collection: AppCollection) -> bool {
    // These collections predate namespaced app scopes in released clients.
    if appID == "inbe" && ValidLegacyEncryptedCollection(collection.CollectionPrefix) {
        return collection.Visibility == "private"
    }
    prefix := collection.CollectionPrefix
    if text.TextHasSuffix(prefix, ".*") {
        prefix = prefix[:prefix.count - 2]
    }
    visibility := wire_text.Cut(prefix, #char ".")
    app := wire_text.Cut(visibility.after, #char ".")
    return app.found && app.before == appID && visibility.before == collection.Visibility
}

DeclaresCollection :: (collections: []AppCollection, prefix: string) -> bool {
    index: s64 = 0
    while index < collections.count {
        if collections[index].CollectionPrefix == prefix {
            return true
        }
        index += 1
    }
    return false
}

CollectionMatchesPrefix :: (collection: string, prefix: string) -> bool {
    if collection == prefix {
        return true
    }
    if text.TextHasSuffix(prefix, ".*") {
        return text.TextHasPrefix(collection, prefix[:prefix.count - 1])
    }
    return false
}

LikePatternForCollectionPrefix :: (prefix: string) -> Vec(u8) {
    base := prefix
    if text.TextHasSuffix(base, ".*") {
        base = base[:base.count - 2]
    }
    pattern: Vec(u8)
    for byte: base {
        if byte == #char "\\" || byte == #char "%" || byte == #char "_" {
            if !VecPush(pattern, #char "\\") {
                return .{}
            }
        }
        if !VecPush(pattern, byte) {
            return .{}
        }
    }
    if !VecPush(pattern, #char ".") || !VecPush(pattern, #char "%") {
        return .{}
    }
    return pattern
}
