// Shared two-factor verification semantics for both server targets. The
// native server (account_2fa_native) and the Go server (account_2fa) call
// into this module, so the accepted codes, crypto formats, rate limits and
// status meanings cannot drift between targets again. The SQL statements
// live in account_2fa_queries, which both targets also share.
totp :: #import "crypto/totp";
chacha :: #import "crypto/chacha20";
kdf :: #import "crypto/kdf";
sha :: #import "crypto/sha256";
wipe :: #import "crypto/wipe";

VerifyStatus :: enum {
    Allowed :: 0
    Missing :: 1
    Invalid :: 2
    RateLimited :: 3
    Error :: 4
}

// What the caller must write after Evaluate. AdvanceTotp carries the
// verified step in Evaluation.step; ConsumeRecovery carries the digest in
// Evaluation.recoveryHash. The caller answers Allowed only when that write
// changed exactly one row; a lost race counts as Invalid.
Decision :: enum {
    None :: 0
    AdvanceTotp :: 1
    ConsumeRecovery :: 2
}

Evaluation :: struct {
    decision: Decision
    status: VerifyStatus
    step: s64
    recoveryHash: string
}

// 15 minutes, shared with the confirm endpoint. IP bucket first, then the
// account bucket, and only once a code was actually supplied.
RateWindowSeconds :: 900;
UserRateLimit :: 10;
AddressRateLimit :: 30;
AddressBucketPrefix :: "2fa:ip:";
UserBucketPrefix :: "2fa:user:";
HeaderName :: "X-Mesh-2FA";
RawSecretBytes :: 20;
SealedSecretBytes :: 60; // 24-byte nonce + 20-byte secret + 16-byte tag
SealedSecretHex :: 120;

#scope_export
DeriveSecretKey :: (serverSecret: []u8, user: string, keyOut: []u8) -> bool {
    if serverSecret.count == 0 || user.count == 0 || keyOut.count != 32 { return false }
    salt := "mesh-2fa-totp-key-v1"
    saltBytes: [20]u8
    for i: 0..19 { saltBytes[i] = salt[i] }
    infoBytes: [64]u8
    if user.count != 64 { return false }
    for i: 0..63 { infoBytes[i] = user[i] }
    return kdf.HkdfSha256(saltBytes[:], serverSecret, infoBytes[:], keyOut)
}

BuildAad :: (user: string, out: []u8) -> s64 {
    prefix := "mesh-2fa-totp-v1\n"
    if user.count != 64 || out.count < prefix.count + 64 { return -1 }
    for i: 0..prefix.count-1 { out[i] = prefix[i] }
    for i: 0..63 { out[prefix.count + i] = user[i] }
    return prefix.count + 64
}

#scope_file
HexNibble :: (ch: u8) -> s32 {
    if ch >= cast(u8)48 && ch <= cast(u8)57 { return cast(s32)(ch - cast(u8)48) }
    if ch >= cast(u8)97 && ch <= cast(u8)102 { return cast(s32)(ch - cast(u8)97) + 10 }
    if ch >= cast(u8)65 && ch <= cast(u8)70 { return cast(s32)(ch - cast(u8)65) + 10 }
    return -1
}

DecodeHex :: (text: string, out: []u8) -> bool {
    if text.count != out.count * 2 { return false }
    for i: 0..out.count-1 {
        hi := HexNibble(text[i * 2])
        lo := HexNibble(text[i * 2 + 1])
        if hi < 0 || lo < 0 { return false }
        out[i] = cast(u8)(hi * 16 + lo)
    }
    return true
}

NormalizeRecoveryCode :: (text: string, out: []u8) -> bool {
    if out.count < 16 { return false }
    written: s64 = 0
    for i: 0..text.count-1 {
        ch := text[i]
        if ch == cast(u8)32 || ch == cast(u8)45 || ch == cast(u8)9 { continue }
        if ch >= cast(u8)97 && ch <= cast(u8)102 { ch -= cast(u8)32 }
        if !((ch >= cast(u8)48 && ch <= cast(u8)57) || (ch >= cast(u8)65 && ch <= cast(u8)70)) {
            return false
        }
        if written >= 16 { return false }
        out[written] = ch
        written += 1
    }
    return written == 16
}

#scope_export
HashRecoveryCode :: (user: string, canonical16: []u8, hexOut: []u8) -> bool {
    if user.count != 64 || canonical16.count != 16 || hexOut.count < 65 { return false }
    payload: Vec(u8)
    if !BuilderAppend(payload, "mesh-2fa-recovery-v1\n") || !BuilderAppend(payload, user) ||
        !BuilderAppend(payload, "\n") || !BuilderAppend(payload, TextView(canonical16)) {
        return false
    }
    digest := sha.Sha256Of(TextView(VecSlice(payload, 0, payload.count)))
    defer wipe.SecureWipe(digest[:])
    return sha.BytesToHex(*digest[0], digest.count, *hexOut[0], hexOut.count) == 1
}

#scope_export
OpenSecret :: (serverSecret: []u8, user: string, hexIn: string, rawOut: []u8) -> bool {
    if rawOut.count != RawSecretBytes || hexIn.count != SealedSecretHex { return false }
    sealed: [SealedSecretBytes]u8
    defer wipe.SecureWipe(sealed[:])
    if !DecodeHex(hexIn, sealed[:]) { return false }
    key: [32]u8
    defer wipe.SecureWipe(key[:])
    if !DeriveSecretKey(serverSecret, user, key[:]) { return false }
    aad: [96]u8
    aadLen := BuildAad(user, aad[:])
    if aadLen < 0 { return false }
    opened := chacha.XChaCha20Poly1305OpenBytes(key[:], sealed[:24], sealed[24:], aad[:aadLen], rawOut)
    return opened == RawSecretBytes
}

// Classifies a supplied code against one account's stored state without
// touching the database. recoveryHashOut must hold at least 65 bytes and is
// written before the result references it. secretEnc is the stored
// totp_secret_enc hex; lastStep is the stored last_used_step.
Evaluate :: (serverSecret: []u8, user: string, code: string, secretEnc: string,
    lastStep: s64, nowUnix: s64, recoveryHashOut: []u8) -> Evaluation {
    result: Evaluation
    if secretEnc.count != SealedSecretHex {
        result.status = .Error
        return result
    }

    // 1. Try 6-digit TOTP code.
    digitsBuf: [8]u8
    if totp.NormalizeCode(code, totp.TOTP_DEFAULT_DIGITS, digitsBuf[:]) == cast(s64)totp.TOTP_DEFAULT_DIGITS {
        rawSecret: [RawSecretBytes]u8
        defer wipe.SecureWipe(rawSecret[:])
        if !OpenSecret(serverSecret, user, secretEnc, rawSecret[:]) {
            result.status = .Error
            return result
        }
        verified := totp.VerifyTotp(rawSecret[:], code, nowUnix, totp.TOTP_DEFAULT_PERIOD,
            totp.TOTP_DEFAULT_DIGITS, totp.TOTP_DEFAULT_SKEW, lastStep)
        if verified.valid {
            // Status is the fallback when the caller's replay-guard write
            // does not change exactly one row: the code matched, but a
            // concurrent use won the race, which counts as Invalid.
            result.decision = .AdvanceTotp
            result.status = .Invalid
            result.step = verified.step
            return result
        }
        result.status = .Invalid
        return result
    }

    // 2. Try 16-hex recovery code.
    canonical: [16]u8
    defer wipe.SecureWipe(canonical[:])
    if NormalizeRecoveryCode(code, canonical[:]) {
        if recoveryHashOut.count < 65 || !HashRecoveryCode(user, canonical[:], recoveryHashOut) {
            result.status = .Error
            return result
        }
        // Same fallback semantics as the TOTP branch: only a write that
        // consumes an unused recovery code turns this into Allowed.
        result.decision = .ConsumeRecovery
        result.status = .Invalid
        result.recoveryHash = TextView(recoveryHashOut[:64])
        return result
    }
    result.status = .Invalid
    return result
}
