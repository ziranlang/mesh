// Explicit ASCII validation preserves the released protocol's byte grammar.
wire_text :: #import "wire_text";

ValidUserID :: (value: string) -> bool {
    if value.count != 64 {
        return false
    }
    index: s64 = 0
    while index < value.count {
        byte: u8 = value[index]
        if !(byte >= cast(u8)48 && byte <= cast(u8)57) && !(byte >= cast(u8)97 && byte <= cast(u8)102) {
            return false
        }
        index += 1
    }
    return true
}

// Normalize a hexadecimal account ID into exactly 64 caller-owned bytes.
NormalizeUserID :: (user: string, output: []u8) -> bool {
    value := wire_text.TrimSpace(user)
    if output.count != 64 || value.count != output.count { return false }
    for byte, index: value {
        output[index] = ifx byte >= #char "A" && byte <= #char "F" then byte + 32 else byte
    }
    return ValidUserID(TextView(output))
}

ValidID :: (value: string, minimum: s64, maximum: s64) -> bool {
    if value.count < minimum || value.count > maximum {
        return false
    }
    index: s64 = 0
    while index < value.count {
        byte: u8 = value[index]
        if byte >= cast(u8)65 && byte <= cast(u8)90 {
            index += 1
            continue
        }
        if byte >= cast(u8)97 && byte <= cast(u8)122 {
            index += 1
            continue
        }
        if byte >= cast(u8)48 && byte <= cast(u8)57 {
            index += 1
            continue
        }
        if byte != cast(u8)46 && byte != cast(u8)95 && byte != cast(u8)58 && byte != cast(u8)45 {
            return false
        }
        index += 1
    }
    return true
}

ValidClientID :: (value: string) -> bool {
    return ValidID(value, 8, 128)
}

ValidResourceID :: (value: string) -> bool {
    return ValidID(value, 4, 128)
}

ValidNamespace :: (value: string) -> bool {
    if value == "." || value == ".." {
        return false
    }
    return ValidID(value, 1, 64)
}

ValidEncryptedRecordID :: (value: string) -> bool {
    return ValidID(value, 1, 160)
}

ValidAccountAlias :: (value: string) -> bool {
    if value.count < 4 || value.count > 32 {
        return false
    }
    index: s64 = 0
    while index < value.count {
        byte: u8 = value[index]
        if !(byte >= cast(u8)97 && byte <= cast(u8)122) && !(byte >= cast(u8)48 && byte <= cast(u8)57) && byte != cast(u8)95 {
            return false
        }
        index += 1
    }
    return true
}

ValidNamespaceSegment :: (value: string) -> bool {
    if !ValidNamespace(value) {
        return false
    }
    index: s64 = 0
    while index < value.count {
        if value[index] == cast(u8)46 {
            return false
        }
        index += 1
    }
    return true
}

ValidVersionSegment :: (value: string) -> bool {
    if value.count < 2 || value.count > 5 {
        return false
    }
    if value[0] != cast(u8)118 || value[1] < cast(u8)49 || value[1] > cast(u8)57 {
        return false
    }
    index: s64 = 2
    while index < value.count {
        if value[index] < cast(u8)48 || value[index] > cast(u8)57 {
            return false
        }
        index += 1
    }
    return true
}

ValidEncryptedHierarchyCollection :: (collection: string) -> bool {
    scope := wire_text.Cut(wire_text.TrimSpace(collection), #char ".")
    if !scope.found {
        return false
    }
    if scope.before == "account" {
        version := wire_text.Cut(scope.after, #char ".")
        return version.found && ValidVersionSegment(version.before) && ValidNamespaceSegment(version.after)
    }
    if scope.before != "private" && scope.before != "shared" &&
        scope.before != "friends" && scope.before != "public" {
        return false
    }

    app := wire_text.Cut(scope.after, #char ".")
    version := wire_text.Cut(app.after, #char ".")
    if !app.found || !version.found || !ValidNamespaceSegment(app.before) ||
        !ValidVersionSegment(version.before) {
        return false
    }
    remaining := version.after
    while remaining.count > 0 {
        segment := wire_text.Cut(remaining, #char ".")
        if !ValidNamespaceSegment(segment.before) {
            return false
        }
        if !segment.found {
            return true
        }
        remaining = segment.after
    }
    return false
}

ValidLegacyEncryptedCollection :: (collection: string) -> bool {
    value: string = wire_text.TrimSpace(collection)
    return value == "inbe.habits" || value == "inbe.habit_days" || value == "inbe.sessions"
}
