#if TARGET == .C && OS == .LINUX {
    sqlite :: #import "sqlite/SQLite";
    sql :: #import "sqlite_statement_native";
    queries :: #import "account_2fa_queries";
    transport :: #import "http_server_native";
    bearer :: #import "http_auth_native";
    replies :: #import "http_json_native";
    address :: #import "client_address_native";
    limiting :: #import "rate_limit_native";
    coding :: #import "content_coding_native";
    limits :: #import "server_limits";
    verify :: #import "account_2fa_verify";
    wire :: #import "wire_text";
    format :: #import "timestamp_format";
    totp :: #import "crypto/totp";
    chacha :: #import "crypto/chacha20";
    sha :: #import "crypto/sha256";
    wipe :: #import "crypto/wipe";
    random :: #import "std/random_linux";
    clock :: #import "std/timer";
    calendar :: #import "std/date_time_linux";
    mutex :: #import "std/mutex_linux";
    json :: #import "std/json_document";
    #import "std/vec"

    MaxRequestBytes :: 4096;

    #scope_file
    StatusRoute :: "/api/v1/account/2fa";
    SetupRoute :: "/api/v1/account/2fa/totp/setup";
    ConfirmRoute :: "/api/v1/account/2fa/totp/confirm";
    DisableRoute :: "/api/v1/account/2fa/disable";
    RegenerateRoute :: "/api/v1/account/2fa/recovery/regenerate";

    PendingLifetimeSeconds :: 600;
    RecoveryCodeCount :: 10;

    NoStoreReply :: (connection: *void, status: u32, document: *json.JsonDocument, root: s32) -> s32 {
        headers: [1]transport.HeaderValue = .[.{name = "Cache-Control", value = "private, no-store"}]
        return replies.ReplyWithHeaders(connection, status, document, root, headers[:])
    }

    NoStoreError :: (connection: *void, status: u32, message: string) -> s32 {
        document: json.JsonDocument
        root := json.JsonNewObject(*document)
        if !json.JsonSet(*document, root, "error", json.JsonNewString(*document, message)) { return 0 }
        return NoStoreReply(connection, status, *document, root)
    }

    AuditTime :: (now: s64, target: []u8) -> s64 {
        return format.UTC(.{seconds = now / 1000, nanoseconds = cast(s32)(now % 1000) * 1000000, valid = true}, target)
    }

    SealSecret :: (serverSecret: []u8, user: string, rawSecret: []u8, hexOut: []u8) -> bool {
        if rawSecret.count != verify.RawSecretBytes || hexOut.count < verify.SealedSecretHex + 1 { return false }
        key: [32]u8
        defer wipe.SecureWipe(key[:])
        if !verify.DeriveSecretKey(serverSecret, user, key[:]) { return false }
        nonce: [24]u8
        if !random.FillSecure(nonce[:]) { return false }
        aad: [96]u8
        aadLen := verify.BuildAad(user, aad[:])
        if aadLen < 0 { return false }
        sealed: [verify.SealedSecretBytes]u8
        defer wipe.SecureWipe(sealed[:])
        for i: 0..23 { sealed[i] = nonce[i] }
        written := chacha.XChaCha20Poly1305SealBytes(key[:], nonce[:], rawSecret, aad[:aadLen], sealed[24:])
        if written != verify.RawSecretBytes + 16 { return false }
        return sha.BytesToHex(*sealed[0], verify.SealedSecretBytes, *hexOut[0], hexOut.count) == 1
    }

    FormatRecoveryCode :: (raw8: []u8, formatted19: []u8, canonical16: []u8) -> bool {
        if raw8.count != 8 || formatted19.count < 19 || canonical16.count < 16 { return false }
        hex: [17]u8
        if sha.BytesToHex(*raw8[0], 8, *hex[0], 17) != 1 { return false }
        for i: 0..15 {
            ch := hex[i]
            if ch >= cast(u8)97 && ch <= cast(u8)102 { ch -= cast(u8)32 }
            canonical16[i] = ch
        }
        out := 0
        for i: 0..15 {
            if i > 0 && (i % 4) == 0 {
                formatted19[out] = cast(u8)45
                out += 1
            }
            formatted19[out] = canonical16[i]
            out += 1
        }
        return out == 19
    }

    GenerateRecoveryCodes :: (database: *void, user: string, doc: *json.JsonDocument, arrayOut: *s32) -> bool {
        delArgs: [1]sql.Argument = .[sql.TextArg(user)]
        if sql.Execute(database, queries.DeleteRecoveryCodes, delArgs[:]) != sqlite.SQLITE_OK {
            return false
        }
        arr := json.JsonNewArray(doc)
        for i: 0..RecoveryCodeCount-1 {
            raw: [8]u8
            defer wipe.SecureWipe(raw[:])
            if !random.FillSecure(raw[:]) { return false }
            formatted: [19]u8
            canonical: [16]u8
            defer wipe.SecureWipe(formatted[:])
            defer wipe.SecureWipe(canonical[:])
            if !FormatRecoveryCode(raw[:], formatted[:], canonical[:]) { return false }
            hashHex: [65]u8
            if !verify.HashRecoveryCode(user, canonical[:], hashHex[:]) { return false }
            insArgs: [2]sql.Argument = .[sql.TextArg(user), sql.TextArg(TextView(hashHex[:64]))]
            if sql.Execute(database, queries.InsertRecoveryCode, insArgs[:]) != sqlite.SQLITE_OK {
                return false
            }
            if !json.JsonAppend(doc, arr, json.JsonNewStringCopy(doc, TextView(formatted[:]))) {
                return false
            }
        }
        <<arrayOut = arr
        return true
    }

    Allow2FA :: (limiter: *limiting.RateLimiter, connection: *void, user: string) -> bool {
        now := clock.MonotonicMilliseconds()
        ip := address.FromRequest(connection)
        ipBucket: Vec(u8)
        userBucket: Vec(u8)
        if !BuilderAppend(ipBucket, verify.AddressBucketPrefix) || !BuilderAppend(ipBucket, TextView(ip.bytes[:ip.count])) ||
            !BuilderAppend(userBucket, verify.UserBucketPrefix) || !BuilderAppend(userBucket, user) {
            return false
        }
        if !limiting.Allow(limiter, TextView(VecSlice(ipBucket, 0, ipBucket.count)), verify.AddressRateLimit,
            verify.RateWindowSeconds * 1000, now) {
            return false
        }
        return limiting.Allow(limiter, TextView(VecSlice(userBucket, 0, userBucket.count)), verify.UserRateLimit,
            verify.RateWindowSeconds * 1000, now)
    }

    RevokeOthers :: (database: *void, connection: *void, user: string) -> bool {
        token := bearer.Bearer(connection)
        if token == "" { return true }
        digest := sha.Sha256Of(token)
        hashHex: [65]u8
        if sha.BytesToHex(*digest[0], digest.count, *hashHex[0], hashHex.count) != 1 { return false }
        args: [2]sql.Argument = .[sql.TextArg(user), sql.TextArg(TextView(hashHex[:64]))]
        return sql.Execute(database, queries.RevokeOtherSessions, args[:]) == sqlite.SQLITE_OK
    }

    ActionInput :: struct {
        code: Text
        revokeOthers: bool
        valid: bool
    }

    ReadActionInput :: (body: []u8) -> ActionInput {
        if body.count == 0 { return .{valid = true} }
        doc: json.JsonDocument
        if !json.JsonRead(*doc, TextView(body)) { return .{} }
        kind := json.JsonKindOf(*doc, doc.root)
        if kind != .Object && kind != .Null { return .{} }
        result: ActionInput = .{valid = true}
        node := json.JsonFirst(*doc, doc.root)
        while node >= 0 {
            name: Text = json.JsonKey(*doc, node)
            key := TextView(name)
            vkind := json.JsonKindOf(*doc, node)
            if vkind != .Null {
                if wire.MatchesToken(key, "code") || wire.MatchesToken(key, "totp_code") ||
                    wire.MatchesToken(key, "recovery_code") || wire.MatchesToken(key, "two_factor_code") {
                    if vkind != .String { return .{} }
                    if TextView(result.code) == "" {
                        result.code = json.JsonString(*doc, node)
                    }
                } else if wire.MatchesToken(key, "revoke_other_sessions") {
                    if vkind != .True && vkind != .False { return .{} }
                    result.revokeOthers = vkind == .True
                }
            }
            node = json.JsonNext(*doc, node)
        }
        return result
    }

    #scope_export
    Initialize :: (database: *void) -> s32 {
        return sqlite.SqliteExecText(database, queries.Schema)
    }

    HeaderCode :: (connection: *void) -> string {
        return wire.TrimSpace(transport.Header(connection, verify.HeaderName))
    }

    // Caller must hold databaseLock.
    CheckRequest :: (database: *void, limiter: *limiting.RateLimiter, serverSecret: []u8,
        connection: *void, user: string, bodyCode: string, nowUnix: s64) -> verify.VerifyStatus {
        args: [1]sql.Argument = .[sql.TextArg(user)]
        stmt := sql.Prepare(database, queries.ReadState, args[:])
        if stmt.status != sqlite.SQLITE_OK { return .Error }
        defer sqlite.SqliteFinalize(stmt.value)
        step := sqlite.SqliteStep(stmt.value)
        if step == sqlite.SQLITE_DONE { return .Allowed }
        if step != sqlite.SQLITE_ROW { return .Error }
        enabled := sqlite.SqliteColumnInt64(stmt.value, 0)
        if enabled == 0 { return .Allowed }
        secretEnc := sql.ColumnText(stmt.value, 1)
        lastStep := sqlite.SqliteColumnInt64(stmt.value, 4)

        code := HeaderCode(connection)
        if code == "" { code = wire.TrimSpace(bodyCode) }
        if code == "" { return .Missing }
        if !Allow2FA(limiter, connection, user) { return .RateLimited }

        // Copy secretEnc out before finalizing or mutating DB.
        encBuf: [verify.SealedSecretHex]u8
        if secretEnc.count != verify.SealedSecretHex { return .Error }
        for i: 0..verify.SealedSecretHex-1 { encBuf[i] = secretEnc[i] }

        hashHex: [65]u8
        evaluated := verify.Evaluate(serverSecret, user, code, TextView(encBuf[:]), lastStep,
            nowUnix, hashHex[:])
        if evaluated.decision == .AdvanceTotp {
            advArgs: [3]sql.Argument = .[sql.TextArg(user), sql.IntArg(evaluated.step), sql.IntArg(nowUnix)]
            if sql.Execute(database, queries.AdvanceStep, advArgs[:]) != sqlite.SQLITE_OK {
                return .Error
            }
            if sqlite.SqliteChanges(database) == 1 {
                return .Allowed
            }
            return .Invalid
        }
        if evaluated.decision == .ConsumeRecovery {
            recArgs: [3]sql.Argument = .[sql.TextArg(user), sql.TextArg(evaluated.recoveryHash), sql.IntArg(nowUnix)]
            if sql.Execute(database, queries.ConsumeRecoveryCode, recArgs[:]) != sqlite.SQLITE_OK {
                return .Error
            }
            if sqlite.SqliteChanges(database) == 1 {
                return .Allowed
            }
        }
        return evaluated.status
    }

    WriteRejected :: (connection: *void, status: verify.VerifyStatus) -> s32 {
        if status == .Missing {
            doc: json.JsonDocument
            root := json.JsonNewObject(*doc)
            methods := json.JsonNewArray(*doc)
            if !json.JsonAppend(*doc, methods, json.JsonNewString(*doc, "totp")) ||
                !json.JsonAppend(*doc, methods, json.JsonNewString(*doc, "recovery_code")) ||
                !json.JsonSet(*doc, root, "error", json.JsonNewString(*doc, "2fa_required")) ||
                !json.JsonSet(*doc, root, "methods", methods) {
                return 0
            }
            return NoStoreReply(connection, 401, *doc, root)
        }
        if status == .RateLimited {
            return NoStoreError(connection, 429, "2fa rate limit exceeded")
        }
        if status == .Invalid {
            return NoStoreError(connection, 401, "invalid 2fa code")
        }
        return NoStoreError(connection, 500, "2fa verification failed")
    }

    Handles :: (path: string) -> bool {
        return path == StatusRoute || path == SetupRoute || path == ConfirmRoute ||
            path == DisableRoute || path == RegenerateRoute
    }

    ReadsBody :: (path: string, method: string) -> bool {
        return method == "POST" && (path == SetupRoute || path == ConfirmRoute ||
            path == DisableRoute || path == RegenerateRoute)
    }

    Handle :: (database: *void, databaseLock: *mutex.Mutex, limiter: *limiting.RateLimiter,
        serverSecret: []u8, zstdRequests: bool, connection: *void, method: string,
        path: string, input: []u8, overflow: bool) -> s32 {
        isStatus := path == StatusRoute
        allowed := ifx isStatus then "GET, HEAD" else "POST"
        supported := ifx isStatus then (method == "GET" || method == "HEAD") else (method == "POST")
        if !supported {
            headers: [1]transport.HeaderValue = .[.{name = "Allow", value = allowed}]
            empty: [0]u8
            return transport.WriteWithHeaders(connection, 405, "", empty[:], headers[:])
        }
        body := input
        decodedBuf: [MaxRequestBytes]u8
        if !isStatus {
            if overflow || input.count > MaxRequestBytes {
                return NoStoreError(connection, 400, "request body too large")
            }
            encHeader: [limits.MaxHeaderBytes]u8
            encLen := transport.JoinHeader(connection, "Content-Encoding", encHeader[:])
            if encLen < 0 {
                return NoStoreError(connection, 400, "unsupported content encoding")
            }
            encText := TextView(encHeader[:encLen])
            if encText != "" && !wire.MatchesToken(wire.TrimSpace(encText), "identity") {
                decoded := coding.Decode(input, encText, zstdRequests, MaxRequestBytes, decodedBuf[:])
                if decoded.error != "" {
                    return NoStoreError(connection, 400, decoded.error)
                }
                body = decoded.bytes
            }
        }
        nowMs := calendar.UnixMilliseconds()
        nowUnix := nowMs / 1000
        audit: [32]u8
        auditCount := AuditTime(nowMs, audit[:])
        if nowMs < 0 || auditCount == 0 || !mutex.Lock(databaseLock) {
            return NoStoreError(connection, 500, "2fa unavailable")
        }
        defer mutex.Unlock(databaseLock)
        auth := bearer.Authenticate(database, connection, serverSecret, nowUnix, TextView(audit[:auditCount]), false)
        if auth.status != 0 {
            return NoStoreError(connection, auth.status, auth.message)
        }
        user := TextView(auth.userID[:])

        if isStatus {
            return HandleStatus(database, connection, user, nowUnix)
        }
        if path == SetupRoute {
            return HandleSetup(database, serverSecret, connection, user, nowUnix)
        }
        parsed := ReadActionInput(body)
        if !parsed.valid {
            return NoStoreError(connection, 400, "invalid json")
        }
        if path == ConfirmRoute {
            return HandleConfirm(database, limiter, serverSecret, connection, user,
                TextView(parsed.code), parsed.revokeOthers, nowUnix)
        }
        if path == DisableRoute {
            return HandleDisable(database, limiter, serverSecret, connection, user,
                TextView(parsed.code), parsed.revokeOthers, nowUnix)
        }
        return HandleRegenerate(database, limiter, serverSecret, connection, user,
            TextView(parsed.code), nowUnix)
    }

    #scope_file
    HandleStatus :: (database: *void, connection: *void, user: string, nowUnix: s64) -> s32 {
        enabled := false
        pending := false
        args: [1]sql.Argument = .[sql.TextArg(user)]
        stmt := sql.Prepare(database, queries.ReadState, args[:])
        if stmt.status != sqlite.SQLITE_OK { return NoStoreError(connection, 500, "2fa status failed") }
        step := sqlite.SqliteStep(stmt.value)
        if step == sqlite.SQLITE_ROW {
            enabled = sqlite.SqliteColumnInt64(stmt.value, 0) != 0
            pendingEnc := sql.ColumnText(stmt.value, 2)
            pendingExp := sqlite.SqliteColumnInt64(stmt.value, 3)
            pending = !enabled && pendingEnc.count > 0 && pendingExp >= nowUnix
        } else if step != sqlite.SQLITE_DONE {
            unused sqlite.SqliteFinalize(stmt.value)
            return NoStoreError(connection, 500, "2fa status failed")
        }
        unused sqlite.SqliteFinalize(stmt.value)

        remaining := sql.ReadInteger(database, queries.CountRecovery, args[:])
        if remaining.status != sqlite.SQLITE_OK { return NoStoreError(connection, 500, "2fa status failed") }

        doc: json.JsonDocument
        root := json.JsonNewObject(*doc)
        methods := json.JsonNewArray(*doc)
        if enabled {
            if !json.JsonAppend(*doc, methods, json.JsonNewString(*doc, "totp")) ||
                !json.JsonAppend(*doc, methods, json.JsonNewString(*doc, "recovery_code")) {
                return 0
            }
        }
        if !json.JsonSet(*doc, root, "enabled", json.JsonNewBool(*doc, enabled)) ||
            !json.JsonSet(*doc, root, "pending", json.JsonNewBool(*doc, pending)) ||
            !json.JsonSet(*doc, root, "methods", methods) ||
            !json.JsonSet(*doc, root, "recovery_codes_remaining", json.JsonNewInteger(*doc, remaining.value)) {
            return 0
        }
        return NoStoreReply(connection, 200, *doc, root)
    }

    HandleSetup :: (database: *void, serverSecret: []u8, connection: *void, user: string, nowUnix: s64) -> s32 {
        rawSecret: [verify.RawSecretBytes]u8
        defer wipe.SecureWipe(rawSecret[:])
        if !random.FillSecure(rawSecret[:]) {
            return NoStoreError(connection, 500, "2fa setup failed")
        }
        encHex: [verify.SealedSecretHex + 1]u8
        if !SealSecret(serverSecret, user, rawSecret[:], encHex[:]) {
            return NoStoreError(connection, 500, "2fa setup failed")
        }
        expiresAt := nowUnix + PendingLifetimeSeconds
        args: [4]sql.Argument = .[sql.TextArg(user), sql.TextArg(TextView(encHex[:verify.SealedSecretHex])),
            sql.IntArg(expiresAt), sql.IntArg(nowUnix)]
        if sql.Execute(database, queries.UpsertPending, args[:]) != sqlite.SQLITE_OK {
            return NoStoreError(connection, 500, "2fa setup failed")
        }
        if sqlite.SqliteChanges(database) == 0 {
            return NoStoreError(connection, 409, "2fa already enabled")
        }
        b32: [40]u8
        defer wipe.SecureWipe(b32[:])
        b32Len := totp.Base32Encode(rawSecret[:], b32[:])
        if b32Len <= 0 {
            return NoStoreError(connection, 500, "2fa setup failed")
        }
        uri: Vec(u8)
        if !BuilderAppend(uri, "otpauth://totp/Mesh:") || !BuilderAppend(uri, user[:12]) ||
            !BuilderAppend(uri, "?secret=") || !BuilderAppend(uri, TextView(b32[:b32Len])) ||
            !BuilderAppend(uri, "&issuer=Mesh&algorithm=SHA1&digits=6&period=30") {
            return 0
        }
        doc: json.JsonDocument
        root := json.JsonNewObject(*doc)
        if !json.JsonSet(*doc, root, "secret", json.JsonNewStringCopy(*doc, TextView(b32[:b32Len]))) ||
            !json.JsonSet(*doc, root, "otpauth_uri", json.JsonNewStringCopy(*doc, TextView(VecSlice(uri, 0, uri.count)))) ||
            !json.JsonSet(*doc, root, "digits", json.JsonNewInteger(*doc, 6)) ||
            !json.JsonSet(*doc, root, "period", json.JsonNewInteger(*doc, 30)) ||
            !json.JsonSet(*doc, root, "expires_in_seconds", json.JsonNewInteger(*doc, PendingLifetimeSeconds)) {
            return 0
        }
        return NoStoreReply(connection, 200, *doc, root)
    }

    HandleConfirm :: (database: *void, limiter: *limiting.RateLimiter, serverSecret: []u8,
        connection: *void, user: string, bodyCode: string, revokeOthers: bool, nowUnix: s64) -> s32 {
        code := HeaderCode(connection)
        if code == "" { code = wire.TrimSpace(bodyCode) }
        if code == "" { return NoStoreError(connection, 400, "totp code required") }
        if !Allow2FA(limiter, connection, user) { return NoStoreError(connection, 429, "2fa rate limit exceeded") }

        args: [1]sql.Argument = .[sql.TextArg(user)]
        stmt := sql.Prepare(database, queries.ReadState, args[:])
        if stmt.status != sqlite.SQLITE_OK { return NoStoreError(connection, 500, "2fa confirm failed") }
        step := sqlite.SqliteStep(stmt.value)
        if step == sqlite.SQLITE_DONE {
            unused sqlite.SqliteFinalize(stmt.value)
            return NoStoreError(connection, 400, "no pending 2fa setup")
        }
        if step != sqlite.SQLITE_ROW {
            unused sqlite.SqliteFinalize(stmt.value)
            return NoStoreError(connection, 500, "2fa confirm failed")
        }
        enabled := sqlite.SqliteColumnInt64(stmt.value, 0)
        pendingEnc := sql.ColumnText(stmt.value, 2)
        pendingExp := sqlite.SqliteColumnInt64(stmt.value, 3)
        encBuf: [verify.SealedSecretHex]u8
        hasPending := pendingEnc.count == verify.SealedSecretHex
        if hasPending {
            for i: 0..verify.SealedSecretHex-1 { encBuf[i] = pendingEnc[i] }
        }
        unused sqlite.SqliteFinalize(stmt.value)

        if enabled != 0 { return NoStoreError(connection, 409, "2fa already enabled") }
        if !hasPending || pendingExp < nowUnix { return NoStoreError(connection, 400, "no pending 2fa setup") }

        rawSecret: [verify.RawSecretBytes]u8
        defer wipe.SecureWipe(rawSecret[:])
        if !verify.OpenSecret(serverSecret, user, TextView(encBuf[:]), rawSecret[:]) {
            return NoStoreError(connection, 500, "2fa confirm failed")
        }
        verified := totp.VerifyTotp(rawSecret[:], code, nowUnix, totp.TOTP_DEFAULT_PERIOD,
            totp.TOTP_DEFAULT_DIGITS, totp.TOTP_DEFAULT_SKEW, -1)
        if !verified.valid {
            return NoStoreError(connection, 401, "invalid 2fa code")
        }

        if sqlite.SqliteExecText(database, "BEGIN IMMEDIATE") != sqlite.SQLITE_OK {
            return NoStoreError(connection, 500, "2fa confirm failed")
        }
        actArgs: [4]sql.Argument = .[sql.TextArg(user), sql.TextArg(TextView(encBuf[:])),
            sql.IntArg(verified.step), sql.IntArg(nowUnix)]
        if sql.Execute(database, queries.ActivateTotp, actArgs[:]) != sqlite.SQLITE_OK ||
            sqlite.SqliteChanges(database) != 1 {
            unused sqlite.SqliteExecText(database, "ROLLBACK")
            return NoStoreError(connection, 500, "2fa confirm failed")
        }
        doc: json.JsonDocument
        root := json.JsonNewObject(*doc)
        codesArr: s32 = -1
        if !GenerateRecoveryCodes(database, user, *doc, *codesArr) {
            unused sqlite.SqliteExecText(database, "ROLLBACK")
            return NoStoreError(connection, 500, "2fa confirm failed")
        }
        if revokeOthers && !RevokeOthers(database, connection, user) {
            unused sqlite.SqliteExecText(database, "ROLLBACK")
            return NoStoreError(connection, 500, "2fa confirm failed")
        }
        if sqlite.SqliteExecText(database, "COMMIT") != sqlite.SQLITE_OK {
            unused sqlite.SqliteExecText(database, "ROLLBACK")
            return NoStoreError(connection, 500, "2fa confirm failed")
        }
        if !json.JsonSet(*doc, root, "enabled", json.JsonNewBool(*doc, true)) ||
            !json.JsonSet(*doc, root, "recovery_codes", codesArr) {
            return 0
        }
        return NoStoreReply(connection, 200, *doc, root)
    }

    HandleDisable :: (database: *void, limiter: *limiting.RateLimiter, serverSecret: []u8,
        connection: *void, user: string, bodyCode: string, revokeOthers: bool, nowUnix: s64) -> s32 {
        check := CheckRequest(database, limiter, serverSecret, connection, user, bodyCode, nowUnix)
        if check != .Allowed { return WriteRejected(connection, check) }
        if sqlite.SqliteExecText(database, "BEGIN IMMEDIATE") != sqlite.SQLITE_OK {
            return NoStoreError(connection, 500, "2fa disable failed")
        }
        args: [1]sql.Argument = .[sql.TextArg(user)]
        if sql.Execute(database, queries.DeleteRecoveryCodes, args[:]) != sqlite.SQLITE_OK ||
            sql.Execute(database, queries.DisableAccount, args[:]) != sqlite.SQLITE_OK ||
            (revokeOthers && !RevokeOthers(database, connection, user)) {
            unused sqlite.SqliteExecText(database, "ROLLBACK")
            return NoStoreError(connection, 500, "2fa disable failed")
        }
        if sqlite.SqliteExecText(database, "COMMIT") != sqlite.SQLITE_OK {
            unused sqlite.SqliteExecText(database, "ROLLBACK")
            return NoStoreError(connection, 500, "2fa disable failed")
        }
        doc: json.JsonDocument
        root := json.JsonNewObject(*doc)
        if !json.JsonSet(*doc, root, "enabled", json.JsonNewBool(*doc, false)) { return 0 }
        return NoStoreReply(connection, 200, *doc, root)
    }

    HandleRegenerate :: (database: *void, limiter: *limiting.RateLimiter, serverSecret: []u8,
        connection: *void, user: string, bodyCode: string, nowUnix: s64) -> s32 {
        // Must have 2FA enabled and verify a valid code.
        args: [1]sql.Argument = .[sql.TextArg(user)]
        stmt := sql.Prepare(database, queries.ReadState, args[:])
        if stmt.status != sqlite.SQLITE_OK { return NoStoreError(connection, 500, "2fa regenerate failed") }
        step := sqlite.SqliteStep(stmt.value)
        enabled := step == sqlite.SQLITE_ROW && sqlite.SqliteColumnInt64(stmt.value, 0) != 0
        unused sqlite.SqliteFinalize(stmt.value)
        if !enabled { return NoStoreError(connection, 400, "2fa not enabled") }

        check := CheckRequest(database, limiter, serverSecret, connection, user, bodyCode, nowUnix)
        if check != .Allowed { return WriteRejected(connection, check) }

        if sqlite.SqliteExecText(database, "BEGIN IMMEDIATE") != sqlite.SQLITE_OK {
            return NoStoreError(connection, 500, "2fa regenerate failed")
        }
        doc: json.JsonDocument
        root := json.JsonNewObject(*doc)
        codesArr: s32 = -1
        if !GenerateRecoveryCodes(database, user, *doc, *codesArr) {
            unused sqlite.SqliteExecText(database, "ROLLBACK")
            return NoStoreError(connection, 500, "2fa regenerate failed")
        }
        if sqlite.SqliteExecText(database, "COMMIT") != sqlite.SQLITE_OK {
            unused sqlite.SqliteExecText(database, "ROLLBACK")
            return NoStoreError(connection, 500, "2fa regenerate failed")
        }
        if !json.JsonSet(*doc, root, "recovery_codes", codesArr) { return 0 }
        return NoStoreReply(connection, 200, *doc, root)
    }
}
