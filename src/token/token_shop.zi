#import "protocol"
#import "std/go_types"
rules :: #import "token_shop_rules";
errors :: #import "std/errors_go";

Title :: (action: string) -> string {
    return rules.Title(action)
}

Validate :: (request: TokenSpendRequest) -> Error {
    problem := rules.Validate(request.AppID, request.Action, request.IdempotencyKey, request.Amount, request.Metadata)
    if problem != "" {
        return errors.New(problem)
    }
    return null
}
