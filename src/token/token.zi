#import "identity"
#import "std/random_go"
#import "std/vec"
clock :: #import "std/time_go";
payload_rules :: #import "token_payload";
wire :: #import "token_wire";
hmac :: #import "token_hmac_go";

AuthTokenResult :: struct {
    value: string
    error: string
}

ParseInteger :: (text: string) -> payload_rules.ParsedInteger {
    return payload_rules.ParseInteger(text)
}

// Clock and duration policy stay explicit at the caller until the service
// lifecycle is ported; the wire bytes and authentication decisions live here.
IssueAuthToken :: (secret: []u8, userID: string, expiresAt: s64) -> AuthTokenResult {
    result: AuthTokenResult
    if secret.count == 0 || !ValidUserID(userID) {
        result.error = "invalid token input"
        return result
    }
    sessionBytes: [32]u8
    filled := Fill(sessionBytes[:])
    if filled.error != null {
        result.error = "secure session allocation failed"
        return result
    }
    formatted := payload_rules.FormatV2(userID, expiresAt, clock.Unix(clock.Now()), sessionBytes)
    if formatted.count == 0 {
        result.error = "invalid token input"
        return result
    }
    signed := wire.Sign(secret, TextView(formatted.bytes[:formatted.count]), hmac.Compute)
    if signed.error != "" { return .{error = signed.error} }
    bytes := signed.value
    result.value = BuilderFinish(bytes)
    return result
}

VerifyAuthToken :: (secret: []u8, token: string, now: s64) -> AuthTokenResult {
    result: AuthTokenResult
    metadata := InspectAuthToken(secret, token)
    if metadata.error != "" {
        result.error = metadata.error
        return result
    }
    if now > metadata.value.expiresAt {
        result.error = "token expired"
        return result
    }
    result.value = metadata.value.userID
    return result
}

InspectAuthToken :: (secret: []u8, token: string) -> payload_rules.AuthTokenMetadataResult {
    payload := wire.Verify(secret, token, hmac.Compute)
    if payload.error != "" { return .{error = payload.error} }
    bytes := payload.value
    return payload_rules.Parse(BuilderFinish(bytes))
}
