go_strings :: #system_library "go:strings";
builtin :: #system_library "go:builtin";

ErrManifestOutdated: Error = errors.New("app manifest is older than the installed manifest");

ManifestSequenceResult :: struct {
    value: s64
    found: bool
    error: Error
}
AppKeyResult :: struct {
    value: AppKey
    found: bool
    error: Error
}
AppKeysResult :: struct {
    value: []AppKey
    error: Error
}
TokenPoliciesResult :: struct {
    value: []TokenPolicy
    error: Error
}
TokenPolicyResult :: struct {
    value: TokenPolicy
    found: bool
    error: Error
}
TokenPolicyExistsResult :: struct {
    value: bool
    error: Error
}
AppResult :: struct {
    value: AppRegistration
    found: bool
    error: Error
}
AppsResult :: struct {
    value: []AppRegistration
    error: Error
}
CollectionsResult :: struct {
    value: []AppCollection
    error: Error
}
CapabilitiesResult :: struct {
    value: []string
    error: Error
}
ExistsResult :: struct {
    value: bool
    error: Error
}

#scope_file
TransactionResult :: struct {
    value: *sql.Transaction
    error: Error
}
ExecResult :: struct {
    value: sql.Result
    error: Error
}
RowsResult :: struct {
    value: *sql.Rows
    error: Error
}
TrimSpace :: (value: string) -> string #foreign go_strings;
Compare :: (left: string, right: string) -> isize #foreign go_strings;
Begin :: (database: *sql.Database, context: ctx.Context, options: *sql.TransactionOptions) -> TransactionResult #go_results #foreign go_sql "(*DB).BeginTx";
RollbackAtReturn :: (transaction: *sql.Transaction) #go_defer #foreign go_sql "(*Tx).Rollback";
CloseAtReturn :: (rows: *sql.Rows) #go_defer #foreign go_sql "(*Rows).Close";
DeleteByApp :: (transaction: *sql.Transaction, context: ctx.Context, query: string, appID: string) -> ExecResult #go_results #foreign go_sql "(*Tx).ExecContext";
InsertApp :: (transaction: *sql.Transaction, context: ctx.Context, query: string, appID: string, name: string, description: string, homepage: string, source: string, key: string, status: string, schema: isize, minimum: string, current: string, compatibility: string, features: string, legacy: string) -> ExecResult #go_results #foreign go_sql "(*Tx).ExecContext";
InsertCollection :: (transaction: *sql.Transaction, context: ctx.Context, query: string, appID: string, prefix: string, visibility: string, schema: isize, description: string) -> ExecResult #go_results #foreign go_sql "(*Tx).ExecContext";
InsertCapability :: (transaction: *sql.Transaction, context: ctx.Context, query: string, appID: string, capability: string) -> ExecResult #go_results #foreign go_sql "(*Tx).ExecContext";
InsertPolicy :: (transaction: *sql.Transaction, context: ctx.Context, query: string, appID: string, asset: string, permission: string, status: string, legacy: s64) -> ExecResult #go_results #foreign go_sql "(*Tx).ExecContext";
InsertManifest :: (transaction: *sql.Transaction, context: ctx.Context, query: string, appID: string, version: isize, value: string, hash: string, signature: string, approval: string, expiry: s64, status: string) -> ExecResult #go_results #foreign go_sql "(*Tx).ExecContext";
InsertKey :: (transaction: *sql.Transaction, context: ctx.Context, query: string, appID: string, keyID: string, algorithm: string, key: string, purpose: string, status: string, expiry: s64) -> ExecResult #go_results #foreign go_sql "(*Tx).ExecContext";
QueryOne :: (database: *sql.Database, context: ctx.Context, query: string, appID: string) -> *sql.Row #foreign go_sql "(*DB).QueryRowContext";
QueryTwo :: (database: *sql.Database, context: ctx.Context, query: string, appID: string, keyID: string) -> *sql.Row #foreign go_sql "(*DB).QueryRowContext";
QueryThree :: (database: *sql.Database, context: ctx.Context, query: string, appID: string, asset: string, permission: string) -> *sql.Row #foreign go_sql "(*DB).QueryRowContext";
QueryRows :: (database: *sql.Database, context: ctx.Context, query: string, appID: string) -> RowsResult #go_results #foreign go_sql "(*DB).QueryContext";
ScanCount :: (row: *sql.Row, count: *isize) -> Error #foreign go_sql "(*Row).Scan";
ScanKey :: (row: *sql.Row, keyID: *string, algorithm: *string, key: *string, purpose: *string, status: *string, expiry: *s64, created: *string) -> Error #foreign go_sql "(*Row).Scan";
ScanKeyRows :: (rows: *sql.Rows, keyID: *string, algorithm: *string, key: *string, purpose: *string, status: *string, expiry: *s64, created: *string) -> Error #foreign go_sql "(*Rows).Scan";
ScanPolicy :: (row: *sql.Row, asset: *string, permission: *string, status: *string, legacy: *s64) -> Error #foreign go_sql "(*Row).Scan";
ScanPolicyRows :: (rows: *sql.Rows, asset: *string, permission: *string, status: *string, legacy: *s64) -> Error #foreign go_sql "(*Rows).Scan";
ScanManifest :: (row: *sql.Row, version: *isize, value: *string, hash: *string, signature: *string, approval: *string, expiry: *s64) -> Error #foreign go_sql "(*Row).Scan";
AppendKey :: (keys: []AppKey, key: AppKey) -> []AppKey #foreign builtin "append";
AppendPolicy :: (policies: []TokenPolicy, policy: TokenPolicy) -> []TokenPolicy #foreign builtin "append";
AppendApp :: (apps: []AppRegistration, app: AppRegistration) -> []AppRegistration #foreign builtin "append";
AppendCollection :: (collections: []AppCollection, collection: AppCollection) -> []AppCollection #foreign builtin "append";
AppendString :: (values: []string, value: string) -> []string #foreign builtin "append";
AllocateApps :: (count: isize) -> []AppRegistration #foreign builtin "make";
AllocateCollections :: (count: isize) -> []AppCollection #foreign builtin "make";
AllocateStrings :: (count: isize) -> []string #foreign builtin "make";
AllocatePolicies :: (count: isize) -> []TokenPolicy #foreign builtin "make";
QueryAll :: (database: *sql.Database, context: ctx.Context, query: string) -> RowsResult #go_results #foreign go_sql "(*DB).QueryContext";
ScanApp :: (row: *sql.Row, appID: *string, name: *string, description: *string, homepage: *string, source: *string, key: *string, status: *string, schema: *isize, minimum: *string, current: *string, compatibility: *string, features: *string, legacy: *string, created: *string, updated: *string) -> Error #foreign go_sql "(*Row).Scan";
ScanAppRows :: (rows: *sql.Rows, appID: *string, name: *string, description: *string, homepage: *string, source: *string, key: *string, status: *string, schema: *isize, minimum: *string, current: *string, compatibility: *string, features: *string, legacy: *string, created: *string, updated: *string) -> Error #foreign go_sql "(*Rows).Scan";
ScanCollection :: (rows: *sql.Rows, appID: *string, prefix: *string, visibility: *string, schema: *isize, description: *string, created: *string) -> Error #foreign go_sql "(*Rows).Scan";
ScanString :: (rows: *sql.Rows, value: *string) -> Error #foreign go_sql "(*Rows).Scan";

DecodeMetadata :: (features: string, legacy: string, app: *AppRegistration) -> Error {
    if TrimSpace(features) != "" {
        error := json.Unmarshal(text.ToBytes(features), *app.Features)
        if error != null {
            return error
        }
    }
    if TrimSpace(legacy) != "" {
        error := json.Unmarshal(text.ToBytes(legacy), *app.LegacyProtocols)
        if error != null {
            return error
        }
    }
    return null
}

Hydrate :: (database: *sql.Database, context: ctx.Context, app: *AppRegistration) -> Error {
    collections := Collections(database, context, app.AppID)
    app.Collections = collections.value
    if collections.error != null {
        return collections.error
    }
    capabilities := Capabilities(database, context, app.AppID)
    app.Capabilities = capabilities.value
    if capabilities.error != null {
        return capabilities.error
    }
    return HydrateManifest(database, context, app)
}

ReplacePolicies :: (transaction: *sql.Transaction, context: ctx.Context, appID: string, policies: []TokenPolicy) -> Error {
    deleted := DeleteByApp(transaction, context, registration.ClearAppTokenPoliciesSQL, appID)
    if deleted.error != null {
        return deleted.error
    }
    for policy: policies {
        inserted := InsertPolicy(transaction, context, registration.InsertAppTokenPolicySQL, appID, policy.AssetID,
            policy.Permission, manifest.DefaultString(policy.Status, "active"), policy.LegacyUnsignedUntil)
        if inserted.error != null {
            return inserted.error
        }
    }
    return null
}

UpsertTransaction :: (transaction: *sql.Transaction, context: ctx.Context, app: AppRegistration) -> Error {
    status := TrimSpace(app.Status)
    features := json.Marshal(app.Features)
    if features.error != null {
        return features.error
    }
    legacy := json.Marshal(app.LegacyProtocols)
    if legacy.error != null {
        return legacy.error
    }
    if status == "" {
        status = "active"
    }
    statement := registration.Write(registration.Parameters)
    if statement.count == 0 { return errors.New("could not build app registration statement") }
    inserted := InsertApp(transaction, context, TextView(VecSlice(statement, 0, statement.count)), app.AppID, app.DisplayName,
        app.Description, app.HomepageURL, app.SourceURL, app.PublicKey, status,
        app.AppSchemaVersion, app.MinClientVersion, app.CurrentVersion, app.CompatibilityUntil,
        text.FromBytes(features.value), text.FromBytes(legacy.value))
    if inserted.error != null {
        return inserted.error
    }
    collections := DeleteByApp(transaction, context, registration.ClearAppCollectionsSQL, app.AppID)
    if collections.error != null {
        return collections.error
    }
    for collection: app.Collections {
        written := InsertCollection(transaction, context, registration.InsertAppCollectionSQL, app.AppID,
            collection.CollectionPrefix, collection.Visibility, collection.SchemaVersion, collection.Description)
        if written.error != null {
            return written.error
        }
    }
    capabilities := DeleteByApp(transaction, context, registration.ClearAppCapabilitiesSQL, app.AppID)
    if capabilities.error != null {
        return capabilities.error
    }
    for capability: app.Capabilities {
        written := InsertCapability(transaction, context, registration.InsertAppCapabilitySQL, app.AppID, capability)
        if written.error != null {
            return written.error
        }
    }
    return ReplacePolicies(transaction, context, app.AppID, app.TokenPolicies)
}

#scope_export
Upsert :: (database: *sql.Database, context: ctx.Context, app: AppRegistration) -> Error {
    begun := Begin(database, context, null)
    if begun.error != null {
        return begun.error
    }
    transaction := begun.value
    RollbackAtReturn(transaction)
    error := UpsertTransaction(transaction, context, app)
    if error != null {
        return error
    }
    return sql.Commit(transaction)
}

// The manifest_sequence of the app's installed signed manifest, if any.
InstalledSequence :: (database: *sql.Database, context: ctx.Context, appID: string) -> ManifestSequenceResult {
    arguments: [1]Any = .[appID]
    return ReadSequence(sql.QueryRow(database, context, registration.InstalledManifestSQL, arguments[:]))
}

UpsertSignedManifest :: (database: *sql.Database, context: ctx.Context, value: AppManifest, bytes: []u8, hash: string, signature: string, approval: string) -> Error {
    begun := Begin(database, context, null)
    if begun.error != null {
        return begun.error
    }
    transaction := begun.value
    RollbackAtReturn(transaction)
    // Anyone may submit a signed manifest, and an old approval stays signed.
    // Without this check it could undo a later suspension or key revocation.
    arguments: [1]Any = .[value.AppID]
    installed := ReadSequence(sql.QueryRowTx(transaction, context, registration.InstalledManifestSQL, arguments[:]))
    if installed.error != null {
        return installed.error
    }
    if installed.found && value.ManifestSequence < installed.value {
        return ErrManifestOutdated
    }
    status := value.Status
    if status == "" {
        status = "active"
    }
    app: AppRegistration
    app.AppID = value.AppID
    app.DisplayName = value.DisplayName
    app.Description = value.Description
    app.HomepageURL = value.HomepageURL
    app.SourceURL = value.SourceURL
    app.Status = status
    app.AppSchemaVersion = value.AppSchemaVersion
    app.MinClientVersion = value.MinClientVersion
    app.CurrentVersion = value.CurrentVersion
    app.CompatibilityUntil = value.CompatibilityUntil
    app.Collections = value.Collections
    app.Capabilities = value.Capabilities
    app.Features = value.Features
    app.LegacyProtocols = value.LegacyProtocols
    app.TokenPolicies = value.TokenPolicies
    if value.Keys.count > 0 {
        app.PublicKey = value.Keys[0].PublicKey
    }
    error := UpsertTransaction(transaction, context, app)
    if error != null {
        return error
    }
    written := InsertManifest(transaction, context, registration.ManifestInsertSQL, value.AppID,
        value.ManifestVersion, text.FromBytes(bytes), hash, signature, approval, value.ExpiresAt, status)
    if written.error != null {
        return written.error
    }
    deleted := DeleteByApp(transaction, context, registration.ClearAppKeysSQL, value.AppID)
    if deleted.error != null {
        return deleted.error
    }
    for key: value.Keys {
        inserted := InsertKey(transaction, context, registration.KeyInsertSQL, value.AppID, key.KeyID,
            key.Algorithm, key.PublicKey, manifest.DefaultString(key.Purpose, "signing"),
            manifest.DefaultString(key.Status, "active"), key.ExpiresAt)
        if inserted.error != null {
            return inserted.error
        }
    }
    error = ReplacePolicies(transaction, context, value.AppID, value.TokenPolicies)
    if error != null {
        return error
    }
    return sql.Commit(transaction)
}

ActiveKey :: (database: *sql.Database, context: ctx.Context, appID: string, keyID: string) -> AppKeyResult {
    result: AppKeyResult
    key: AppKey
    row := QueryTwo(database, context, ActiveKeySQL, appID, keyID)
    error := ScanKey(row, *key.KeyID, *key.Algorithm, *key.PublicKey, *key.Purpose,
        *key.Status, *key.ExpiresAt, *key.CreatedAt)
    if errors.Is(error, sql.NoRows()) {
        return result
    }
    if error != null {
        result.error = error
        return result
    }
    if key.ExpiresAt > 0 && clock.Unix(clock.Now()) > key.ExpiresAt {
        return result
    }
    result.value = key
    result.found = true
    return result
}

HydrateManifest :: (database: *sql.Database, context: ctx.Context, app: *AppRegistration) -> Error {
    manifestJSON := ""
    row := QueryOne(database, context, reads.HydrateSQL, app.AppID)
    error := ScanManifest(row, *app.ManifestVersion, *manifestJSON, *app.ManifestHash,
        *app.ManifestSignature, *app.ApprovalSignature, *app.ManifestExpiresAt)
    if error != null && !errors.Is(error, sql.NoRows()) {
        return error
    }
    if manifestJSON != "" {
        value: AppManifest
        error = json.Unmarshal(text.ToBytes(manifestJSON), *value)
        if error != null {
            return error
        }
        app.AppSchemaVersion = value.AppSchemaVersion
        app.MinClientVersion = value.MinClientVersion
        app.CurrentVersion = value.CurrentVersion
        app.CompatibilityUntil = value.CompatibilityUntil
        app.Features = value.Features
        app.LegacyProtocols = value.LegacyProtocols
    }
    keys := Keys(database, context, app.AppID)
    if keys.error != null {
        return keys.error
    }
    app.Keys = keys.value
    policies := Policies(database, context, app.AppID)
    if policies.error != null {
        return policies.error
    }
    app.TokenPolicies = policies.value
    return null
}

Keys :: (database: *sql.Database, context: ctx.Context, appID: string) -> AppKeysResult {
    result: AppKeysResult
    queried := QueryRows(database, context, reads.KeysSQL, appID)
    if queried.error != null {
        result.error = queried.error
        return result
    }
    rows := queried.value
    CloseAtReturn(rows)
    keys: []AppKey
    while sql.Next(rows) {
        key: AppKey
        result.error = ScanKeyRows(rows, *key.KeyID, *key.Algorithm, *key.PublicKey,
            *key.Purpose, *key.Status, *key.ExpiresAt, *key.CreatedAt)
        if result.error != null {
            return result
        }
        keys = AppendKey(keys, key)
    }
    result.value = keys
    result.error = sql.RowsError(rows)
    return result
}

Policies :: (database: *sql.Database, context: ctx.Context, appID: string) -> TokenPoliciesResult {
    result: TokenPoliciesResult
    queried := QueryRows(database, context, reads.PoliciesSQL, appID)
    if queried.error != null {
        result.error = queried.error
        return result
    }
    rows := queried.value
    CloseAtReturn(rows)
    policies: []TokenPolicy
    while sql.Next(rows) {
        policy: TokenPolicy
        result.error = ScanPolicyRows(rows, *policy.AssetID, *policy.Permission,
            *policy.Status, *policy.LegacyUnsignedUntil)
        if result.error != null {
            return result
        }
        policies = AppendPolicy(policies, policy)
    }
    result.value = policies
    result.error = sql.RowsError(rows)
    return result
}

Permission :: (database: *sql.Database, context: ctx.Context, appID: string, asset: string, permission: string) -> TokenPolicyResult {
    result: TokenPolicyResult
    policy: TokenPolicy
    row := QueryThree(database, context, PermissionSQL, appID, asset, permission)
    error := ScanPolicy(row, *policy.AssetID, *policy.Permission, *policy.Status, *policy.LegacyUnsignedUntil)
    if errors.Is(error, sql.NoRows()) {
        return result
    }
    result.value = policy
    result.found = error == null
    result.error = error
    return result
}

HasPolicy :: (database: *sql.Database, context: ctx.Context, appID: string) -> TokenPolicyExistsResult {
    result: TokenPolicyExistsResult
    count: isize = 0
    row := QueryOne(database, context, "SELECT COUNT(*) FROM token_app_permissions WHERE app_id=?1", appID)
    result.error = ScanCount(row, *count)
    result.value = count > 0
    return result
}

List :: (database: *sql.Database, context: ctx.Context) -> AppsResult {
    result: AppsResult
    queried := QueryAll(database, context, reads.RegistryListSQL)
    if queried.error != null {
        result.error = queried.error
        return result
    }
    rows := queried.value
    CloseAtReturn(rows)
    apps := AllocateApps(0)
    while sql.Next(rows) {
        app: AppRegistration
        features := ""
        legacy := ""
        result.error = ScanAppRows(rows, *app.AppID, *app.DisplayName, *app.Description,
            *app.HomepageURL, *app.SourceURL, *app.PublicKey, *app.Status,
            *app.AppSchemaVersion, *app.MinClientVersion, *app.CurrentVersion,
            *app.CompatibilityUntil, *features, *legacy, *app.CreatedAt, *app.UpdatedAt)
        if result.error != null {
            return result
        }
        result.error = DecodeMetadata(features, legacy, *app)
        if result.error != null {
            return result
        }
        apps = AppendApp(apps, app)
    }
    result.error = sql.RowsError(rows)
    if result.error != null {
        return result
    }
    index: s64 = 0
    while index < apps.count {
        result.error = Hydrate(database, context, *apps[index])
        if result.error != null {
            return result
        }
        index += 1
    }
    result.value = apps
    return result
}

ByID :: (database: *sql.Database, context: ctx.Context, appID: string) -> AppResult {
    result: AppResult
    app: AppRegistration
    features := ""
    legacy := ""
    row := QueryOne(database, context, reads.ByIDSQL, appID)
    error := ScanApp(row, *app.AppID, *app.DisplayName, *app.Description,
        *app.HomepageURL, *app.SourceURL, *app.PublicKey, *app.Status,
        *app.AppSchemaVersion, *app.MinClientVersion, *app.CurrentVersion,
        *app.CompatibilityUntil, *features, *legacy, *app.CreatedAt, *app.UpdatedAt)
    if errors.Is(error, sql.NoRows()) {
        return result
    }
    if error != null {
        result.error = error
        return result
    }
    result.error = DecodeMetadata(features, legacy, *app)
    if result.error != null {
        return result
    }
    result.error = Hydrate(database, context, *app)
    if result.error != null {
        return result
    }
    result.value = app
    result.found = true
    return result
}

Exists :: (database: *sql.Database, context: ctx.Context, appID: string) -> ExistsResult {
    result: ExistsResult
    count: isize = 0
    row := QueryOne(database, context, reads.ActiveAppSQL, appID)
    result.error = ScanCount(row, *count)
    result.value = count != 0
    return result
}

AllowsLegacyProtocol :: (database: *sql.Database, context: ctx.Context, appID: string, version: isize) -> ExistsResult {
    result: ExistsResult
    loaded := ByID(database, context, appID)
    result.error = loaded.error
    if loaded.error != null || !loaded.found {
        return result
    }
    today := clock.Format(clock.UTC(clock.Now()), "2006-01-02")
    for legacy: loaded.value.LegacyProtocols {
        if legacy.Status != "compatibility" && legacy.Status != "active" {
            continue
        }
        if legacy.Version > 0 && version > legacy.Version {
            continue
        }
        if Compare(legacy.ValidUntil, today) >= 0 {
            result.value = true
            return result
        }
    }
    result.value = loaded.value.CompatibilityUntil != "" && Compare(loaded.value.CompatibilityUntil, today) >= 0
    return result
}

Collections :: (database: *sql.Database, context: ctx.Context, appID: string) -> CollectionsResult {
    result: CollectionsResult
    queried := QueryRows(database, context, reads.CollectionsSQL, appID)
    if queried.error != null {
        result.error = queried.error
        return result
    }
    rows := queried.value
    CloseAtReturn(rows)
    collections := AllocateCollections(0)
    while sql.Next(rows) {
        collection: AppCollection
        result.error = ScanCollection(rows, *collection.AppID, *collection.CollectionPrefix,
            *collection.Visibility, *collection.SchemaVersion, *collection.Description, *collection.CreatedAt)
        if result.error != null {
            return result
        }
        collections = AppendCollection(collections, collection)
    }
    result.value = collections
    result.error = sql.RowsError(rows)
    return result
}

Capabilities :: (database: *sql.Database, context: ctx.Context, appID: string) -> CapabilitiesResult {
    result: CapabilitiesResult
    queried := QueryRows(database, context, reads.CapabilitiesSQL, appID)
    if queried.error != null {
        result.error = queried.error
        return result
    }
    rows := queried.value
    CloseAtReturn(rows)
    values := AllocateStrings(0)
    while sql.Next(rows) {
        value := ""
        result.error = ScanString(rows, *value)
        if result.error != null {
            return result
        }
        values = AppendString(values, value)
    }
    result.value = values
    result.error = sql.RowsError(rows)
    return result
}

OwnsCollection :: (database: *sql.Database, context: ctx.Context, appID: string, collection: string) -> ExistsResult {
    result: ExistsResult
    loaded := Collections(database, context, appID)
    result.error = loaded.error
    if loaded.error != null {
        return result
    }
    for item: loaded.value {
        if scope.CollectionMatchesPrefix(collection, item.CollectionPrefix) {
            result.value = true
            return result
        }
    }
    return result
}

#scope_file
SeedRegistration :: (database: *sql.Database, context: ctx.Context, seedJSON: string) -> Error {
    app: AppRegistration
    decoded := json.Unmarshal(text.ToBytes(seedJSON), *app)
    if decoded != null { return decoded }
    signed: isize
    row := QueryOne(database, context, builtin_seed.ActiveManifest, app.AppID)
    error := ScanCount(row, *signed)
    if error != null || signed != 0 { return error }
    return Upsert(database, context, app)
}

#scope_export
SeedBuiltin :: (database: *sql.Database, context: ctx.Context) -> Error {
    return SeedRegistration(database, context, builtin_seed.Inbe)
}

EntityAppID :: "entity";
EntityCollections :: "private.entity.v1.*";

SeedEntity :: (database: *sql.Database, context: ctx.Context) -> Error {
    return SeedRegistration(database, context, builtin_seed.Entity)
}

#scope_file
ActiveKeySQL :: #string SQL_END

SELECT key_id,algorithm,public_key,purpose,status,expires_at,created_at
FROM server_app_keys WHERE app_id=?1 AND key_id=?2 AND status='active'
SQL_END;
PermissionSQL :: #string SQL_END

SELECT asset_id,permission,status,legacy_unsigned_until
FROM token_app_permissions
WHERE app_id=?1 AND asset_id=?2 AND permission=?3 AND status='active'
SQL_END;

#scope_file
ReadSequence :: (row: *sql.Row) -> ManifestSequenceResult {
    result: ManifestSequenceResult
    encoded: string
    destinations: [1]Any = .[*encoded]
    error := sql.ScanRow(row, destinations[:])
    if errors.Is(error, sql.NoRows()) {
        return result
    }
    result.error = error
    if error != null {
        return result
    }
    installed: AppManifest
    result.error = json.Unmarshal(text.ToBytes(encoded), *installed)
    if result.error != null {
        return result
    }
    result.value = installed.ManifestSequence
    result.found = true
    return result
}
