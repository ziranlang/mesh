#if TARGET == .C && OS == .LINUX {
    accounts :: #import "account_access_native";
    descriptor :: #import "package_release_native";
    offers :: #import "package_offer_native";
    stored :: #import "package_files_native";
    delivery :: #import "package_delivery_native";
    grants :: #import "pack_grant_native";
    wire :: #import "wire_text";
    identity :: #import "identity";
    clock :: #import "std/date_time_linux";
    files :: #import "std/file_linux";
    json :: #import "std/json_document";
    http :: #import "http_server_native";
    response :: #import "http_json_native";
    #import "std/vec"

    #scope_file
    Prefix :: "/api/v2/packages/";

    History :: (connection: *void, method: string, selection: *offers.Selection) -> s32 {
        if !selection.wanted.valid {
            return response.ErrorReply(connection, method, 400, "invalid interface version, format or bucket", false)
        }
        history := offers.ReadHistory(selection.directory, selection.app, true)
        if history.status == 404 { return response.ErrorReply(connection, method, 404, "portable history unavailable", false) }
        if history.status != 200 { return response.ErrorReply(connection, method, 503, "invalid portable history", false) }
        target: json.JsonDocument
        root := json.JsonNewObject(*target)
        versions := json.JsonNewArray(*target)
        count: s32 = 0
        node := history.first
        while node >= 0 && count < 3 {
            release := descriptor.Parse(*history.document, node, selection.app)
            if offers.Fits(*release, selection.wanted) && !offers.HeldBack(selection, release.sequence) &&
                descriptor.Trusted(selection.access, *history.document, *release, selection.app, selection.now) {
                found := offers.Offered(selection, *history.document, *release, *target)
                if found >= 0 {
                    if !json.JsonAppend(*target, versions, found) { return 0 }
                    count += 1
                }
            }
            node = json.JsonNext(*history.document, node)
        }
        if !json.JsonSet(*target, root, "versions", versions) { return 0 }
        return delivery.Metadata(connection, *target, root)
    }

    Latest :: (connection: *void, method: string, selection: *offers.Selection,
        document: *json.JsonDocument, release: *descriptor.Release) -> s32 {
        if !selection.wanted.valid {
            return response.ErrorReply(connection, method, 400, "invalid interface version, format or bucket", false)
        }
        target: json.JsonDocument
        selected: s32 = -1
        if offers.Fits(release, selection.wanted) && !offers.HeldBack(selection, release.sequence) {
            selected = offers.Offered(selection, document, release, *target)
        }
        if selected < 0 { selected = offers.Older(selection, release.sequence, *target) }
        if selected < 0 { return response.ErrorReply(connection, method, 404, "no release for this app version", false) }
        return delivery.Metadata(connection, *target, selected)
    }

    Download :: (connection: *void, method: string, directory: files.FileHandle,
        publicKey: []u8, asset: string, grant: string, size: s64, now: s64) -> s32 {
        if size <= 0 { return response.ErrorReply(connection, method, 404, "package not found", false) }
        name: Vec(u8)
        if !BuilderAppend(name, asset) || !BuilderAppend(name, ".product") { return 0 }
        gate := stored.Read(directory, TextView(VecSlice(name, 0, name.count)), 256)
        if gate.found {
            product := wire.TrimSpace(TextView(VecSlice(gate.bytes, 0, gate.bytes.count)))
            if !gate.valid || !grants.Valid(publicKey, grant, product, now) {
                return response.ErrorReply(connection, method, 403, "package grant required", false)
            }
        }
        content := ifx asset[64:] == ".wasm" then "application/wasm" else "application/octet-stream"
        written := delivery.Artifact(connection, directory, asset, asset[:64], size, content, gate.found)
        if written < 0 { return response.ErrorReply(connection, method, 503, "portable release bytes do not match", false) }
        return written
    }

    AssetValid :: (name: string) -> bool {
        if name.count <= 64 || name.count > 69 || !stored.LowerHash(name[:64]) { return false }
        suffix := name[64:]
        return suffix == ".zx" || suffix == ".zib" || suffix == ".wasm"
    }

    #scope_export
    Handles :: (route: string) -> bool { return wire.TrimPrefix(route, Prefix) != route }

    Handle :: (access: *accounts.AccountAccess, connection: *void, method: string, route: string,
        issuerPublic: []u8) -> s32 {
        if method != "GET" && method != "HEAD" {
            empty: [0]u8
            headers: [1]http.HeaderValue = .[.{name = "Allow", value = "GET, HEAD"}]
            return http.WriteWithHeaders(connection, 405, "", empty[:], headers[:])
        }
        parts := wire.Cut(wire.TrimPrefix(route, Prefix), #char "/")
        named := wire.Cut(parts.after, #char "/")
        app := parts.before
        asset := named.before
        latest := asset == "latest"
        history := asset == "history"
        grant := named.after
        if !parts.found || !identity.ValidNamespace(app) || (!latest && !history && !AssetValid(asset)) ||
            (named.found && (latest || history || grant == "" || wire.Cut(grant, #char "/").found)) {
            return response.ErrorReply(connection, method, 404, "package not found", false)
        }
        now := clock.UnixMilliseconds() / 1000
        status := delivery.CheckApplication(access, app, now)
        if status == 500 { return response.ErrorReply(connection, method, 500, "package registry unavailable", false) }
        if status == 404 { return response.ErrorReply(connection, method, 404, "package not found", false) }
        directory := stored.Open(access.configuration.path, app)
        if !directory.valid { return response.ErrorReply(connection, method, 404, "package not found", false) }
        defer files.CloseFile(directory)
        selection: offers.Selection = .{access = access, directory = directory, app = app, now = now,
            wanted = offers.Wanted(connection)}
        if history { return History(connection, method, *selection) }
        filename: Vec(u8)
        if latest {
            if !BuilderAppend(filename, "latest-v2.json") { return 0 }
        } else if !BuilderAppend(filename, asset) || !BuilderAppend(filename, ".release-v2.json") { return 0 }
        metadata := stored.Read(directory, TextView(VecSlice(filename, 0, filename.count)))
        if !metadata.valid && !metadata.tooLarge {
            return response.ErrorReply(connection, method, 404, "portable release unavailable", false)
        }
        document: json.JsonDocument
        if !offers.ReadDocument(*metadata, *document) {
            return response.ErrorReply(connection, method, 503, "invalid portable release", false)
        }
        release := descriptor.Parse(*document, document.root, app)
        if !release.valid { return response.ErrorReply(connection, method, 503, "invalid portable release", false) }
        if !descriptor.Trusted(access, *document, *release, app, now) {
            return response.ErrorReply(connection, method, 503, "untrusted portable release", false)
        }
        if latest { return Latest(connection, method, *selection, *document, *release) }
        return Download(connection, method, directory, issuerPublic, asset, grant,
            descriptor.ArtifactSize(*document, *release, asset[:64]), now)
    }
}
