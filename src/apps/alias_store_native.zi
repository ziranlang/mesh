#if TARGET == .C && OS == .LINUX {
    catalog :: #import "alias_catalog";
    rules :: #import "entitlement_rules_native";
    wire :: #import "wire_text";
    identity :: #import "identity";
    ledger :: #import "token_ledger_native";
    issuer :: #import "token_issuer_native";
    sqlite :: #import "sqlite/SQLite";
    sql :: #import "sqlite_statement_native";
    json :: #import "std/json_document";
    #import "std/vec"

    #scope_file
    sqlite3 :: #system_library "sqlite3";
    ExtendedError :: (database: *void) -> s32 #foreign sqlite3 "sqlite3_extended_errcode";
    ConstraintUnique :: 2067;
    OwnerSQL :: "SELECT user_id_hash=?2 FROM server_users WHERE alias=?1 COLLATE NOCASE";

    OnDiskAlias :: struct {
        value: Vec(u8)
        found: bool
        ok: bool
    }

    Load :: (database: *void, query: string, arguments: []sql.Argument) -> OnDiskAlias {
        statement := sql.Prepare(database, query, arguments)
        if statement.status != sqlite.SQLITE_OK { return .{} }
        defer sqlite.SqliteFinalize(statement.value)
        step := sqlite.SqliteStep(statement.value)
        if step == sqlite.SQLITE_DONE { return .{ok = true} }
        if step != sqlite.SQLITE_ROW { return .{} }
        result: OnDiskAlias
        result.ok = BuilderAppend(result.value, sql.ColumnText(statement.value, 0))
        result.found = true
        return result
    }

    Owner :: (database: *void, account: string, alias: string) -> sql.IntegerResult {
        arguments: [2]sql.Argument = .[sql.TextArg(alias), sql.TextArg(account)]
        return sql.ReadInteger(database, OwnerSQL, arguments[:])
    }

    ASCII :: (value: string) -> bool {
        for byte: value {
            if byte > 127 { return false }
        }
        return true
    }

    Result :: (alias: string, price: s64, receipt: string, legacy: bool, document: *json.JsonDocument) -> rules.Result {
        root := json.JsonNewObject(document)
        if !ledger.PutText(document, root, "alias", alias) { return rules.Failure(503, "alias purchase unavailable") }
        if legacy {
            if !ledger.PutText(document, root, "status", "ok") { return rules.Failure(500, "alias failed") }
        } else if !ledger.PutInt(document, root, "price_units", price) || !ledger.PutText(document, root, "receipt_id", receipt, true) {
            return rules.Failure(503, "alias purchase unavailable")
        }
        return .{status = 200, node = root}
    }

    #scope_export
    Normalize :: (input: string) -> Vec(u8) {
        normalized: Vec(u8)
        if !ASCII(input) {
            unused BuilderAppend(normalized, input)
            return normalized
        }
        alias := wire.TrimPrefix(wire.TrimSpace(input), "@")
        if !BuilderAppend(normalized, alias) { return .{} }
        {
            bytes := VecSlice(normalized, 0, normalized.count)
            for byte, index: bytes {
                if byte >= #char "A" && byte <= #char "Z" { bytes[index] += #char "a" - #char "A" }
            }
        }
        return normalized
    }

    Quote :: (database: *void, account: string, alias: string, enabled: bool, document: *json.JsonDocument) -> rules.Result {
        unavailable := rules.Failure(503, "alias quote unavailable")
        owner := Owner(database, account, alias)
        if owner.status != sqlite.SQLITE_OK { return unavailable }
        owned := owner.found && owner.value != 0
        if alias == "" || (!identity.ValidAccountAlias(alias) && !owned) {
            return rules.Failure(400, "alias quote unavailable")
        }
        offer: catalog.AliasOffer = .{category = "standard"}
        if enabled { offer = catalog.Find(alias) }
        price := ifx owned then 0 else offer.units
        root := json.JsonNewObject(document)
        if !ledger.PutText(document, root, "alias", alias) || !ledger.PutText(document, root, "category", offer.category) ||
            !ledger.PutInt(document, root, "price_units", price) || !ledger.PutInt(document, root, "units_per_dew", catalog.DewUnits) ||
            !ledger.PutInt(document, root, "minimum_length", 4) || !ledger.PutInt(document, root, "maximum_length", 32) ||
            !json.JsonSet(document, root, "enabled", json.JsonNewBool(document, enabled)) ||
            !json.JsonSet(document, root, "available", json.JsonNewBool(document, !owner.found)) ||
            !json.JsonSet(document, root, "owned", json.JsonNewBool(document, owned)) ||
            !json.JsonSet(document, root, "premium", json.JsonNewBool(document, offer.units > 0)) { return unavailable }
        return .{status = 200, node = root}
    }

    // The caller holds a single write transaction for the name and any debit.
    Claim :: (database: *void, signer: *issuer.Issuer, account: string, alias: string, displayInput: string,
        enabled: bool, confirmed: s64, requestID: string, legacy: bool, auditTime: string, receiptTime: string,
        document: *json.JsonDocument) -> rules.Result {
        unavailable := rules.Failure(503, "alias purchase unavailable")
        if legacy { unavailable = rules.Failure(ifx enabled then 503 else 500, ifx enabled then "alias unavailable" else "alias failed") }
        user: [1]sql.Argument = .[sql.TextArg(account)]
        current := Load(database, "SELECT COALESCE(alias,'') FROM server_users WHERE user_id_hash=?1", user[:])
        if !current.ok { return unavailable }
        if !current.found { return rules.Failure(404, "sync account not found") }
        displayCurrent := TextView(VecSlice(current.value, 0, current.value.count))
        canonical := Normalize(displayCurrent)
        owned := TextView(VecSlice(canonical, 0, canonical.count))
        nonce: Vec(u8)
        if requestID != "" && (!BuilderAppend(nonce, "username:") || !BuilderAppend(nonce, requestID)) { return unavailable }
        key := TextView(VecSlice(nonce, 0, nonce.count))
        if requestID != "" {
            arguments: [2]sql.Argument = .[sql.TextArg(account), sql.TextArg(key)]
            previous := Load(database, "SELECT receipt_id FROM token_spend_nonces WHERE account_id=?1 AND app_id='entity' AND idempotency_key=?2", arguments[:])
            if !previous.ok { return unavailable }
            if previous.found {
                receiptID := TextView(VecSlice(previous.value, 0, previous.value.count))
                receipt := ledger.Receipt(database, receiptID, document)
                if receipt.status != 200 && receipt.status != 404 { return unavailable }
                amount, valid := json.JsonInteger(document, json.JsonMember(document, receipt.node, "amount_delta"))
                if receipt.status == 404 || !valid || amount != -confirmed ||
                    !rules.TextEquals(document, receipt.node, "account_id", account) ||
                    !rules.TextEquals(document, receipt.node, "app_id", "entity") ||
                    !rules.TextEquals(document, receipt.node, "asset_id", ledger.AssetID) ||
                    !rules.TextEquals(document, receipt.node, "event_type", "debit") ||
                    !rules.TextEquals(document, receipt.node, "source_type", "username") ||
                    !rules.TextEquals(document, receipt.node, "source_ref", alias) {
                    return rules.Failure(409, "request_id reused for a different claim")
                }
                if owned != alias { return rules.Failure(409, "claim already completed; alias changed") }
                return Result(alias, -amount, receiptID, false, document)
            }
        }
        if legacy && displayCurrent != "" && ASCII(displayInput) {
            display := wire.TrimPrefix(wire.TrimPrefix(wire.TrimSpace(displayInput), "@"), "@")
            caseOnly := Normalize(display)
            if owned != "" && owned == TextView(VecSlice(caseOnly, 0, caseOnly.count)) {
                update: [2]sql.Argument = .[sql.TextArg(account), sql.TextArg(display)]
                if sql.Execute(database, "UPDATE server_users SET alias=?2 WHERE user_id_hash=?1", update[:]) != sqlite.SQLITE_OK {
                    return rules.Failure(500, "alias failed")
                }
                return Result(display, 0, "", true, document)
            }
        }
        if displayCurrent != "" && owned == alias && (!legacy || enabled) { return Result(alias, 0, "", legacy, document) }
        if !identity.ValidAccountAlias(alias) { return rules.Failure(400, "invalid alias") }
        owner := Owner(database, account, alias)
        if owner.status != sqlite.SQLITE_OK { return unavailable }
        if owner.found && owner.value == 0 { return rules.Failure(409, "alias unavailable") }
        price: s64 = 0
        if enabled { price = catalog.Find(alias).units }
        if price > 0 && (requestID == "" || confirmed == 0) {
            return rules.Failure(402, "premium alias requires explicit purchase at the quoted price")
        }
        if confirmed != price { return rules.Failure(409, "alias price changed; request a new quote") }
        update: [3]sql.Argument = .[sql.TextArg(account), sql.TextArg(alias), sql.TextArg(auditTime)]
        if sql.Execute(database, "UPDATE server_users SET alias=?2,last_seen_at=?3 WHERE user_id_hash=?1", update[:]) != sqlite.SQLITE_OK {
            if ExtendedError(database) == ConstraintUnique { return rules.Failure(409, "alias unavailable") }
            return unavailable
        }
        if sqlite.SqliteChanges(database) != 1 { return rules.Failure(404, "sync account not found") }
        if price == 0 { return Result(alias, 0, "", legacy, document) }
        receipt := rules.Debit(database, signer, .{account = account, app = "entity", kind = "debit", amount = -price,
            source = "username", reference = alias}, receiptTime, key, document)
        if receipt.status == 402 { return rules.Failure(402, "insufficient balance") }
        if receipt.status != 200 { return unavailable }
        receiptID: Text = rules.TextField(document, receipt.node, "receipt_id")
        return Result(alias, price, TextView(receiptID), false, document)
    }
}
