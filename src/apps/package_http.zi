// A verified, immutable artifact store, with one latest release per app.
// An app that cannot run the latest release names the newest host and module
// interfaces it has and gets the newest archived release built for them. A
// staged release reaches only the devices whose bucket is below its share.
// Hosts that run ZX portable executables ask with `format=zx` and get only
// `<sha>.zx` releases. Hosts released before that format ask without it and
// get only their `<sha>.zib` releases, through 2027-10-23.
// A host also names the ZX revision it runs (`zx=R`) and gets only releases
// whose stored `.zx` header has that revision; one that names its interface
// but no revision was released before hosts named it and gets only
// revisions older than the first they named. Web hosts ask with
// `format=wasm` and get the release's signed WebAssembly variant instead.
// An artifact with a `<sha>.zx.product` file next to it is gated: it is
// served only at `<sha>.zx/<grant>` with an unexpired grant for that product.
// Legacy `<sha>.zib` and `<sha>.wasm` artifacts are gated the same way.
#import "std/go_types"
http :: #import "std/http_go";
url :: #import "std/url_go";
rooted :: #import "rooted_files";
json :: #import "std/json_go";
text :: #import "std/text_go";
keys :: #import "std/ed25519_go";
clock :: #import "std/time_go";
store :: #import "app_store";
identity :: #import "identity";
signing :: #import "signing";
response :: #import "response";
registry :: #import "app_http";
release :: #import "package_release";
grants :: #import "pack_grant";
strings :: #system_library "go:strings";
strconv :: #system_library "go:strconv";
hex :: #system_library "go:encoding/hex";
fmt :: #system_library "go:fmt";
go_http :: #system_library "go:net/http";
paths :: #import "path_component";
go_os :: #system_library "go:os";

#scope_file
Decoded :: struct {
    value: []u8
    error: Error
}
WriteResult :: struct {
    count: isize
    error: Error
}
Number :: struct {
    value: s64
    error: Error
}
Interfaces :: struct {
    host: s64
    // The oldest host interface the host still runs; zero when it names none.
    oldest: s64
    module: s64
    // The ZX executable revision the host runs; zero when it names none.
    revision: s64
    // The artifact suffix the host runs: ".zx", ".zib" for hosts released
    // before the ZX format, or ".wasm" for web hosts that run the
    // WebAssembly module lowered from a release's `.zx`.
    format: string
    valid: bool
}
Selected :: struct {
    value: release.ReleaseV2
    found: bool
}
// The publisher's rollout of one release sequence. It is not signed: it only
// holds back a signed release, it can never select unsigned bytes.
Rollout :: struct {
    Sequence: s64 #go_tag "json:\"sequence\""
    Percent: s64 #go_tag "json:\"percent\""
    Until: s64 #go_tag "json:\"until\""
}
// The node's history lists an app's newest ten releases and the newest of
// every format, ZX revision and interface its hosts run, so a device on an
// older host still finds one built for it. It holds at most 64. The history
// it offers for going back lists at most three, the most released apps read.
HistoryRetained :: 64
HistoryOffered :: 3
// The first ZX revision hosts name in their requests. Hosts that name an
// interface but no revision were released before it and run only older ones.
FirstNamedRevision :: 28

// Each entry remains a publisher-signed descriptor. The index itself grants
// no trust; host interfaces and active publisher keys are checked per entry.
ReleaseHistory :: struct {
    Versions: []release.ReleaseV2 #go_tag "json:\"versions\""
}

ParseNumber :: (value: string, base: isize, bits: isize) -> Number #go_results #foreign strconv "ParseInt";
Sequence :: (sequence: s64) -> string #foreign fmt "Sprint";
TrimPrefix :: (value: string, prefix: string) -> string #foreign strings;
TrimSuffix :: (value: string, suffix: string) -> string #foreign strings;
Split :: (value: string, separator: string) -> []string #foreign strings;
Decode :: (value: string) -> Decoded #go_results #foreign hex "DecodeString";
Join :: (a: string, b: string) -> string #foreign fmt "Sprint";
Write :: (writer: http.ResponseWriter, bytes: []u8) -> WriteResult #go_results #foreign go_http "ResponseWriter.Write";
PayloadRead :: struct {
    count: isize
    error: Error
}
ReadAt :: (file: *rooted.File, bytes: []u8, offset: s64) -> PayloadRead #go_results #foreign go_os "(*File).ReadAt";
CloseRootAtReturn :: (root: *rooted.Root) #go_defer #foreign go_os "(*Root).Close";
CloseFileAtReturn :: (file: *rooted.File) #go_defer #foreign go_os "(*File).Close";

OpenPackage :: (dbPath: string, appID: string) -> rooted.RootResult {
    packages := rooted.OpenRoot(Join(dbPath, ".packages"))
    if packages.error != null { return packages }
    CloseRootAtReturn(packages.value)
    return rooted.Child(packages.value, appID, false)
}

// The release hash of a `<sha>.zx`, legacy `<sha>.zib` or WebAssembly
// `<sha>.wasm` artifact name.
ArtifactHash :: (asset: string) -> string {
    suffixes: [3]string = .[".zx", ".zib", ".wasm"]
    for suffix: suffixes {
        hash := TrimSuffix(asset, suffix)
        if asset == Join(hash, suffix) && release.HashValid(hash) {
            return hash
        }
    }
    return ""
}

// Zero means the client did not name that interface and takes any release.
Interface :: (value: string) -> s64 {
    if value == "" {
        return 0
    }
    number := ParseNumber(value, cast(isize)10, cast(isize)64)
    if number.error != null || number.value < 1 || number.value > 65535 {
        return -1
    }
    return number.value
}

// Devices pick a stable bucket from 0 to 99. Apps that send none are served
// last, once a release reaches every device.
Bucket :: (request: *http.Request) -> s64 {
    value := url.Value(url.Query(http.RequestURL(request)), "bucket")
    if value == "" {
        return 99
    }
    number := ParseNumber(value, cast(isize)10, cast(isize)64)
    if number.error != null || number.value < 0 || number.value > 99 {
        return -1
    }
    return number.value
}

// A missing, unreadable or expired rollout file releases to everyone, so a
// staged release never stays held back without a publisher.
HeldBack :: (root: *rooted.Root, sequence: s64, bucket: s64) -> bool {
    metadata := rooted.ReadFile(root, "rollout.json")
    if metadata.error != null || metadata.value.count > 4096 {
        return false
    }
    rollout: Rollout
    if json.Unmarshal(metadata.value, *rollout) != null || rollout.Sequence != sequence ||
    rollout.Percent < 0 || rollout.Percent >= 100 || rollout.Until <= clock.Unix(clock.Now()) {
        return false
    }
    return bucket >= rollout.Percent
}

Wanted :: (request: *http.Request) -> Interfaces {
    query := url.Query(http.RequestURL(request))
    result: Interfaces
    result.host = Interface(url.Value(query, "host_api"))
    result.oldest = Interface(url.Value(query, "oldest_host_api"))
    result.module = Interface(url.Value(query, "module_api"))
    result.revision = Interface(url.Value(query, "zx"))
    format := url.Value(query, "format")
    result.format = ".zib"
    if format == "zx" {
        result.format = ".zx"
    }
    if format == "wasm" {
        result.format = ".wasm"
    }
    known := format == "" || format == "zx" || format == "wasm"
    // Legacy .zib bundles have no ZX revision.
    revisioned := result.revision == 0 || format != ""
    ordered := result.oldest == 0 || result.host == 0 || result.oldest <= result.host
    result.valid = result.host >= 0 && result.oldest >= 0 && result.module >= 0 &&
    result.revision >= 0 && known && revisioned && ordered
    return result
}

// The module artifact's hash, or "" for a release without one.
ModuleHash :: (value: release.ReleaseV2) -> string {
    for artifact: value.Artifacts {
        if artifact.Variant == "module" {
            return artifact.SHA256
        }
    }
    return ""
}

// The executable revision of a stored `.zx`: the little-endian u32 after
// its `ZX\0\0` magic. Zero when the file is missing, short or not ZX.
Revision :: (root: *rooted.Root, name: string) -> s64 {
    opened := rooted.OpenRegular(root, name)
    if opened.error != null {
        return 0
    }
    CloseFileAtReturn(opened.value)
    header: [8]u8
    read := ReadAt(opened.value, header[:], 0)
    if read.count != 8 || header[0] != cast(u8)90 || header[1] != cast(u8)88 ||
    header[2] != cast(u8)0 || header[3] != cast(u8)0 {
        return 0
    }
    return cast(s64)header[4] | (cast(s64)header[5] << 8) |
    (cast(s64)header[6] << 16) | (cast(s64)header[7] << 24)
}

// A host runs only its own ZX revision. One that names its interface but no
// revision was released before hosts named it, so it runs only older ones.
// A client that names neither takes any revision.
RevisionFits :: (revision: s64, wanted: Interfaces) -> bool {
    if wanted.revision > 0 {
        return revision == wanted.revision
    }
    if wanted.host > 0 || wanted.oldest > 0 {
        return revision > 0 && revision < FirstNamedRevision
    }
    return true
}

// A host runs releases built for an interface from its oldest to its own;
// module interfaces must match exactly.
Fits :: (value: release.ReleaseV2, wanted: Interfaces) -> bool {
    return (wanted.host == 0 || value.HostAPI <= wanted.host) &&
    (wanted.oldest == 0 || value.HostAPI >= wanted.oldest) &&
    (wanted.module == 0 || value.ModuleAPI == wanted.module)
}

// A WebAssembly variant signs the same release with its module as the
// artifact; it carries no dependencies of its own.
SameRelease :: (variant: release.ReleaseV2, value: release.ReleaseV2) -> bool {
    return variant.AppID == value.AppID && variant.Sequence == value.Sequence &&
    variant.Version == value.Version && variant.Runtime == value.Runtime &&
    variant.HostAPI == value.HostAPI && variant.ModuleAPI == value.ModuleAPI &&
    variant.DataSchema == value.DataSchema && variant.KeyID == value.KeyID &&
    variant.Channel == value.Channel && variant.Artifacts.count == 1 &&
    variant.Dependencies.count == 0 && value.Dependencies.count == 0
}

// The release's signed WebAssembly variant: the module Ziran lowered from its
// `.zx`, archived as `release-<sequence>.wasm.json` beside `<sha>.wasm`.
WasmVariant :: (context: registry.Registry, request: *http.Request, root: *rooted.Root,
    value: release.ReleaseV2) -> Selected {
    result: Selected
    name := Join(Join("release-", Sequence(value.Sequence)), ".wasm.json")
    metadata := rooted.ReadFile(root, name)
    if metadata.error != null || metadata.value.count > 65536 {
        return result
    }
    variant: release.ReleaseV2
    if json.Unmarshal(metadata.value, *variant) != null ||
    !release.Valid(variant, value.AppID) || !SameRelease(variant, value) {
        return result
    }
    module := Join(variant.Artifacts[0].SHA256, ".wasm")
    if !rooted.Regular(root, module) || !Trusted(context, request, variant) {
        return result
    }
    result.value = variant
    result.found = true
    return result
}

// The signed descriptor a host downloads for this release: the release
// itself when its module is stored in the host's format and ZX revision, or
// for a web host the release's WebAssembly variant.
Offered :: (context: registry.Registry, request: *http.Request, root: *rooted.Root,
    value: release.ReleaseV2, wanted: Interfaces) -> Selected {
    result: Selected
    module := ModuleHash(value)
    if module == "" {
        return result
    }
    if wanted.format == ".zib" {
        result.value = value
        result.found = rooted.Regular(root, Join(module, ".zib"))
        return result
    }
    executable := Join(module, ".zx")
    if !rooted.Regular(root, executable) || !RevisionFits(Revision(root, executable), wanted) {
        return result
    }
    if wanted.format == ".wasm" {
        return WasmVariant(context, request, root, value)
    }
    result.value = value
    result.found = true
    return result
}

Trusted :: (context: registry.Registry, request: *http.Request,
    value: release.ReleaseV2) -> bool {
    key := store.ActiveKey(context.database, http.Context(request), value.AppID, value.KeyID)
    public := Decode(key.value.PublicKey)
    signature := Decode(value.Signature)
    return key.error == null && key.found && key.value.Algorithm == "ed25519" &&
    (key.value.ExpiresAt <= 0 || key.value.ExpiresAt > clock.Unix(clock.Now())) &&
    public.error == null && public.value.count == 32 &&
    signature.error == null && signature.value.count == 64 &&
    keys.Verify(cast(keys.PublicKey)public.value,
        text.ToBytes(release.SigningMessage(value)), signature.value)
}

// Retained choices may have large sequence gaps. Read the bounded history
// first; older stores without it keep their bounded archive fallback.
Older :: (context: registry.Registry, request: *http.Request, root: *rooted.Root,
    appID: string, latest: s64, wanted: Interfaces) -> Selected {
    result: Selected
    retained := rooted.ReadFile(root, "history-v2.json")
    if retained.error == null {
        history: ReleaseHistory
        if retained.value.count > 262144 || json.Unmarshal(retained.value, *history) != null ||
        history.Versions.count == 0 || history.Versions.count > HistoryRetained { return result }
        previous: s64 = 9223372036854775807
        for value: history.Versions {
            if value.Sequence >= previous || !release.Valid(value, appID) { return result }
            previous = value.Sequence
        }
        for value: history.Versions {
            if value.Sequence < latest && Fits(value, wanted) &&
            Trusted(context, request, value) &&
            !HeldBack(root, value.Sequence, Bucket(request)) {
                offered := Offered(context, request, root, value, wanted)
                if offered.found {
                    return offered
                }
            }
        }
        return result
    }
    sequence := latest - 1
    while sequence > 0 && sequence > latest - 256 {
        metadata := rooted.ReadFile(root, Join(Join("release-", Sequence(sequence)), ".json"))
        if metadata.error == null && metadata.value.count <= 65536 {
            value: release.ReleaseV2
            if json.Unmarshal(metadata.value, *value) == null && value.Sequence == sequence &&
            release.Valid(value, appID) && Fits(value, wanted) &&
            Trusted(context, request, value) {
                offered := Offered(context, request, root, value, wanted)
                if offered.found {
                    return offered
                }
            }
        }
        sequence -= 1
    }
    return result
}

History :: (context: registry.Registry, writer: http.ResponseWriter,
    request: *http.Request, root: *rooted.Root, appID: string) {
    wanted := Wanted(request)
    bucket := Bucket(request)
    if !wanted.valid || bucket < 0 {
        response.Error(writer, 400, "invalid interface version, format or bucket")
        return
    }
    metadata := rooted.ReadFile(root, "history-v2.json")
    history: ReleaseHistory
    fallback: [1]release.ReleaseV2
    if metadata.error != null {
        metadata = rooted.ReadFile(root, "latest-v2.json")
        if metadata.error != null || metadata.value.count > 65536 ||
        json.Unmarshal(metadata.value, *fallback[0]) != null {
            response.Error(writer, 404, "portable history unavailable")
            return
        }
        history.Versions = fallback[:]
    } else if metadata.value.count > 262144 || json.Unmarshal(metadata.value, *history) != null {
        response.Error(writer, 503, "invalid portable history")
        return
    }
    if history.Versions.count == 0 || history.Versions.count > HistoryRetained {
        response.Error(writer, 503, "invalid portable history")
        return
    }
    selected: [HistoryOffered]release.ReleaseV2
    count: s64 = 0
    previous: s64 = 9223372036854775807
    for value: history.Versions {
        if value.Sequence >= previous || !release.Valid(value, appID) {
            response.Error(writer, 503, "invalid portable history")
            return
        }
        previous = value.Sequence
        if count < HistoryOffered && Fits(value, wanted) &&
        Trusted(context, request, value) && !HeldBack(root, value.Sequence, bucket) {
            offered := Offered(context, request, root, value, wanted)
            if offered.found {
                selected[count] = offered.value
                count += 1
            }
        }
    }
    http.SetHeader(http.ResponseHeaders(writer), "Cache-Control", "no-store")
    response.JSON(writer, 200, ReleaseHistory.{.Versions = selected[:count]})
}

#scope_export
// Only a hint for apps to check for updates; the update itself is verified.
LatestSequence :: (dbPath: string, appID: string) -> s64 {
    if !identity.ValidNamespace(appID) {
        return 0
    }
    opened := OpenPackage(dbPath, appID)
    if opened.error != null { return 0 }
    root := opened.value
    CloseRootAtReturn(root)
    metadata := rooted.ReadFile(root, "latest-v2.json")
    value: release.ReleaseV2
    if metadata.error != null || metadata.value.count > 65536 ||
    json.Unmarshal(metadata.value, *value) != null || value.AppID != appID || value.Sequence < 0 {
        return 0
    }
    return value.Sequence
}

Route :: (context: registry.Registry, writer: http.ResponseWriter,
    request: *http.Request) {
    path := TrimPrefix(url.Path(http.RequestURL(request)), "/api/v2/packages/")
    parts := Split(path, "/")
    if (parts.count != 2 && parts.count != 3) || !identity.ValidNamespace(parts[0]) {
        response.Error(writer, 404, "package not found")
        return
    }
    appPath := paths.Validate(parts[0])
    assetPath := paths.Validate(parts[1])
    if appPath.error != null || assetPath.error != null {
        response.Error(writer, 404, "package not found")
        return
    }
    appID := appPath.value
    asset := assetPath.value
    grant := ""
    if parts.count == 3 {
        grant = parts[2]
        if asset == "latest" || asset == "history" || grant == "" {
            response.Error(writer, 404, "package not found")
            return
        }
    }
    app := store.ByID(context.database, http.Context(request), appID)
    if app.error != null {
        response.Error(writer, 500, "package registry unavailable")
        return
    }
    if !app.found || app.value.Status != "active" ||
    (app.value.ManifestExpiresAt > 0 &&
        app.value.ManifestExpiresAt <= clock.Unix(clock.Now())) {
        response.Error(writer, 404, "package not found")
        return
    }
    opened := OpenPackage(context.configuration.DBPath, appID)
    if opened.error != null {
        response.Error(writer, 404, "package not found")
        return
    }
    root := opened.value
    CloseRootAtReturn(root)
    if asset == "history" {
        History(context, writer, request, root, appID)
        return
    }
    filename := "latest-v2.json"
    hash := ""
    if asset != "latest" {
        hash = ArtifactHash(asset)
        if hash == "" {
            response.Error(writer, 404, "package not found")
            return
        }
        filename = Join(asset, ".release-v2.json")
    }
    metadata := rooted.ReadFile(root, filename)
    if metadata.error != null {
        response.Error(writer, 404, "portable release unavailable")
        return
    }
    value: release.ReleaseV2
    if metadata.value.count > 65536 ||
    json.Unmarshal(metadata.value, *value) != null ||
    !release.Valid(value, appID) {
        response.Error(writer, 503, "invalid portable release")
        return
    }
    if !Trusted(context, request, value) {
        response.Error(writer, 503, "untrusted portable release")
        return
    }
    if asset == "latest" {
        wanted := Wanted(request)
        bucket := Bucket(request)
        if !wanted.valid || bucket < 0 {
            response.Error(writer, 400, "invalid interface version, format or bucket")
            return
        }
        offered: Selected
        if Fits(value, wanted) && !HeldBack(root, value.Sequence, bucket) {
            offered = Offered(context, request, root, value, wanted)
        }
        if !offered.found {
            offered = Older(context, request, root, appID, value.Sequence, wanted)
        }
        if !offered.found {
            response.Error(writer, 404, "no release for this app version")
            return
        }
        http.SetHeader(http.ResponseHeaders(writer), "Cache-Control", "no-store")
        response.JSON(writer, 200, offered.value)
        return
    }
    expected: s64 = 0
    for artifact: value.Artifacts {
        if artifact.SHA256 == hash {
            expected = artifact.Size
        }
    }
    if expected == 0 {
        response.Error(writer, 404, "package not found")
        return
    }
    // A grant on an artifact that is not gated changes nothing.
    gate := grants.FileGate(rooted.ReadFile(root, Join(asset, ".product")))
    if gate.gated && !grants.Valid(context.configuration.WaoziIssuerPublicKey, grant,
        gate.product, clock.Unix(clock.Now())) {
        response.Error(writer, 403, "package grant required")
        return
    }
    bundle := rooted.ReadFile(root, asset)
    if bundle.error != null || bundle.value.count != expected ||
    signing.SHA256Hex(bundle.value) != hash {
        response.Error(writer, 503, "portable release bytes do not match")
        return
    }
    caching := "public, max-age=31536000, immutable"
    if gate.gated {
        caching = "private, no-store"
    }
    // Browsers compile a WebAssembly module while it streams only with its own type.
    content := "application/octet-stream"
    if TrimSuffix(asset, ".wasm") != asset {
        content = "application/wasm"
    }
    http.SetHeader(http.ResponseHeaders(writer), "Content-Type", content)
    http.SetHeader(http.ResponseHeaders(writer), "Cache-Control", caching)
    http.SetHeader(http.ResponseHeaders(writer), "ETag", Join("\"", Join(hash, "\"")))
    unused Write(writer, bundle.value)
}
