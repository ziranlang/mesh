#if TARGET == .C && OS == .LINUX {
    sqlite :: #import "sqlite/SQLite";
    sql :: #import "sqlite_statement_native";
    queries :: #import "app_registry_queries";
    json :: #import "std/json_document";
    identity :: #import "identity";
    http :: #import "http_server_native";
    text :: #import "std/text_tools";
    #import "std/vec"

    #scope_file
    CollectionPath :: "/collections";
    RegistryPath :: "/api/v1/apps";
    AppPath :: "/api/v1/apps/";

    FieldKind :: enum { RequiredText; OptionalText; OptionalInteger; }
    Field :: struct {
        name: string
        kind: FieldKind
    }

    CopyFields :: (document: *json.JsonDocument, object: s32, row: *void, fields: []Field) -> bool {
        for field, index: fields {
            if field.name == "" {
                continue
            }
            column := cast(s32)index
            value: s32
            if field.kind == .OptionalInteger {
                number := sqlite.SqliteColumnInt64(row, column)
                if number == 0 {
                    continue
                }
                value = json.JsonNewInteger(document, number)
            } else {
                stringValue := sql.ColumnText(row, column)
                if stringValue == "" && field.kind == .OptionalText {
                    continue
                }
                value = json.JsonNewStringCopy(document, stringValue)
            }
            if !json.JsonSet(document, object, field.name, value) {
                return false
            }
        }
        return object >= 0
    }

    ReadArray :: (document: *json.JsonDocument, database: *void, query: string, arguments: []sql.Argument, fields: []Field) -> s32 {
        rows := sql.Prepare(database, query, arguments)
        if rows.status != sqlite.SQLITE_OK {
            return -1
        }
        defer sqlite.SqliteFinalize(rows.value)
        array := json.JsonNewArray(document)
        while true {
            status := sqlite.SqliteStep(rows.value)
            if status == sqlite.SQLITE_DONE {
                return array
            }
            if status != sqlite.SQLITE_ROW {
                return -1
            }
            node: s32
            if fields.count == 0 {
                node = json.JsonNewStringCopy(document, sql.ColumnText(rows.value, 0))
            } else {
                node = json.JsonNewObject(document)
                if !CopyFields(document, node, rows.value, fields) {
                    return -1
                }
            }
            if !json.JsonAppend(document, array, node) {
                return -1
            }
        }
        return -1
    }

    Collections :: (document: *json.JsonDocument, database: *void, arguments: []sql.Argument) -> s32 {
        fields: [6]Field = .[.{name = "app_id", kind = .OptionalText}, .{name = "collection_prefix"}, .{name = "visibility"},
            .{name = "schema_version", kind = .OptionalInteger}, .{name = "description", kind = .OptionalText},
            .{name = "created_at", kind = .OptionalText}]
        return ReadArray(document, database, queries.CollectionsSQL, arguments, fields[:])
    }

    AttachArray :: (document: *json.JsonDocument, object: s32, key: string, array: s32) -> bool {
        return array >= 0 && (json.JsonCount(document, array) == 0 || json.JsonSet(document, object, key, array))
    }

    CopyStoredArray :: (document: *json.JsonDocument, object: s32, key: string, source: *json.JsonDocument, node: s32) -> bool {
        kind := json.JsonKindOf(source, node)
        if kind == .Missing || kind == .Null {
            return true
        }
        return kind == .Array && (json.JsonCount(source, node) == 0 ||
            json.JsonSet(document, object, key, json.JsonCopy(document, source, node)))
    }

    AttachText :: (document: *json.JsonDocument, object: s32, key: string, value: string) -> bool {
        return value == "" || json.JsonSet(document, object, key, json.JsonNewStringCopy(document, value))
    }

    AddMetadata :: (document: *json.JsonDocument, object: s32, row: *void, manifest: *json.JsonDocument) -> bool {
        names: [6]string = .["app_schema_version", "min_supported_client_version", "current_client_version",
            "compatibility_until", "features", "legacy_protocols"]
        signed := manifest.root >= 0
        for name, index: names {
            node := ifx signed then json.JsonMember(manifest, manifest.root, name) else -1
            column := cast(s32)(7 + index)
            if index == 0 {
                version := sqlite.SqliteColumnInt64(row, column)
                if signed {
                    parsed, valid := json.JsonInteger(manifest, node)
                    if !valid && json.JsonKindOf(manifest, node) != .Null && node >= 0 {
                        return false
                    }
                    version = parsed
                }
                if version != 0 && !json.JsonSet(document, object, name, json.JsonNewInteger(document, version)) {
                    return false
                }
            } else if index < 4 {
                if signed {
                    kind := json.JsonKindOf(manifest, node)
                    if kind != .String && kind != .Null && kind != .Missing {
                        return false
                    }
                    value: Text = json.JsonString(manifest, node)
                    if !AttachText(document, object, name, TextView(value)) {
                        return false
                    }
                } else if !AttachText(document, object, name, sql.ColumnText(row, column)) {
                    return false
                }
            } else if signed {
                if !CopyStoredArray(document, object, name, manifest, node) {
                    return false
                }
            } else {
                stored := sql.ColumnText(row, column)
                decoded: json.JsonDocument
                if stored != "" && (!json.JsonRead(*decoded, stored) ||
                    !CopyStoredArray(document, object, name, *decoded, decoded.root)) {
                    return false
                }
            }
        }
        return true
    }

    App :: (document: *json.JsonDocument, database: *void, row: *void) -> s32 {
        appFields: [15]Field = .[.{name = "app_id"}, .{name = "display_name"},
            .{name = "description", kind = .OptionalText}, .{name = "homepage_url", kind = .OptionalText},
            .{name = "source_url", kind = .OptionalText}, .{name = "public_key", kind = .OptionalText}, .{name = "status"},
            .{}, .{}, .{}, .{}, .{}, .{}, .{name = "created_at", kind = .OptionalText}, .{name = "updated_at", kind = .OptionalText}]
        app := json.JsonNewObject(document)
        if !CopyFields(document, app, row, appFields[:]) {
            return -1
        }
        arguments: [1]sql.Argument = .[sql.TextArg(sql.ColumnText(row, 0))]
        selected := sql.Prepare(database, queries.HydrateSQL, arguments[:])
        if selected.status != sqlite.SQLITE_OK {
            return -1
        }
        defer sqlite.SqliteFinalize(selected.value)
        manifest: json.JsonDocument
        manifest.root = -1
        status := sqlite.SqliteStep(selected.value)
        if status == sqlite.SQLITE_ROW {
            fields: [6]Field = .[.{name = "manifest_version", kind = .OptionalInteger}, .{},
                .{name = "manifest_hash", kind = .OptionalText}, .{name = "manifest_signature", kind = .OptionalText},
                .{name = "approval_signature", kind = .OptionalText}, .{name = "manifest_expires_at", kind = .OptionalInteger}]
            encoded := sql.ColumnText(selected.value, 1)
            if !CopyFields(document, app, selected.value, fields[:]) || (encoded != "" && !json.JsonRead(*manifest, encoded)) {
                return -1
            }
            if encoded != "" {
                kind := json.JsonKindOf(*manifest, manifest.root)
                if kind != .Object && kind != .Null {
                    return -1
                }
            }
        } else if status != sqlite.SQLITE_DONE {
            return -1
        }
        if !AddMetadata(document, app, row, *manifest) {
            return -1
        }
        strings: []Field
        keys: [7]Field = .[.{name = "key_id"}, .{name = "algorithm"}, .{name = "public_key"},
            .{name = "purpose", kind = .OptionalText}, .{name = "status", kind = .OptionalText},
            .{name = "expires_at", kind = .OptionalInteger}, .{name = "created_at", kind = .OptionalText}]
        policies: [4]Field = .[.{name = "asset_id"}, .{name = "permission"},
            .{name = "status", kind = .OptionalText}, .{name = "legacy_unsigned_until", kind = .OptionalInteger}]
        if !AttachArray(document, app, "collections", Collections(document, database, arguments[:])) ||
            !AttachArray(document, app, "capabilities", ReadArray(document, database, queries.CapabilitiesSQL, arguments[:], strings)) ||
            !AttachArray(document, app, "keys", ReadArray(document, database, queries.KeysSQL, arguments[:], keys[:])) ||
            !AttachArray(document, app, "token_policies", ReadArray(document, database, queries.PoliciesSQL, arguments[:], policies[:])) {
            return -1
        }
        return app
    }

    Reply :: (connection: *void, status: u32, document: *json.JsonDocument, root: s32) -> s32 {
        payload: Vec(u8)
        if !json.JsonWriteInto(*payload, document, root, json.JsonCompactStyle(false)) || !BuilderAppend(payload, "\n") {
            return 0
        }
        return http.Write(connection, status, "application/json", VecSlice(payload, 0, payload.count))
    }

    Error :: (connection: *void, status: u32, message: string) -> s32 {
        document: json.JsonDocument
        root := json.JsonNewObject(*document)
        if !json.JsonSet(*document, root, "error", json.JsonNewStringCopy(*document, message)) {
            return 0
        }
        return Reply(connection, status, *document, root)
    }

    List :: (database: *void, connection: *void) -> s32 {
        none: []sql.Argument
        rows := sql.Prepare(database, queries.RegistryListSQL, none)
        if rows.status != sqlite.SQLITE_OK {
            return Error(connection, 500, "apps failed")
        }
        defer sqlite.SqliteFinalize(rows.value)
        document: json.JsonDocument
        root := json.JsonNewObject(*document)
        array := json.JsonNewArray(*document)
        while true {
            status := sqlite.SqliteStep(rows.value)
            if status == sqlite.SQLITE_DONE {
                break
            }
            if status != sqlite.SQLITE_ROW || !json.JsonAppend(*document, array, App(*document, database, rows.value)) {
                return Error(connection, 500, "apps failed")
            }
        }
        if !json.JsonSet(*document, root, "apps", array) {
            return 0
        }
        return Reply(connection, 200, *document, root)
    }

    #scope_export
    Details :: (database: *void, connection: *void, app: string, collectionsOnly: bool) -> s32 {
        document: json.JsonDocument
        arguments: [1]sql.Argument = .[sql.TextArg(app)]
        if collectionsOnly {
            collections := Collections(*document, database, arguments[:])
            if collections < 0 {
                return Error(connection, 500, "apps failed")
            }
            if json.JsonCount(*document, collections) == 0 {
                exists := sql.ReadInteger(database, queries.ActiveAppSQL, arguments[:])
                if exists.status != sqlite.SQLITE_OK {
                    return Error(connection, 500, "apps failed")
                }
                if exists.value == 0 {
                    return Error(connection, 404, "app not found")
                }
            }
            root := json.JsonNewObject(*document)
            if !json.JsonSet(*document, root, "collections", collections) {
                return 0
            }
            return Reply(connection, 200, *document, root)
        }
        selected := sql.Prepare(database, queries.ByIDSQL, arguments[:])
        if selected.status != sqlite.SQLITE_OK {
            return Error(connection, 500, "apps failed")
        }
        defer sqlite.SqliteFinalize(selected.value)
        status := sqlite.SqliteStep(selected.value)
        if status == sqlite.SQLITE_DONE {
            return Error(connection, 404, "app not found")
        }
        if status != sqlite.SQLITE_ROW {
            return Error(connection, 500, "apps failed")
        }
        root := App(*document, database, selected.value)
        if root < 0 {
            return Error(connection, 500, "apps failed")
        }
        return Reply(connection, 200, *document, root)
    }

    Handles :: (path: string) -> bool {
        return path == RegistryPath || text.TextHasPrefix(path, AppPath)
    }

    Handle :: (database: *void, connection: *void, method: string, path: string) -> s32 {
        if method != "GET" && method != "HEAD" {
            headers: [1]http.HeaderValue = .[.{name = "Allow", value = "GET, HEAD"}]
            empty: []u8
            return http.WriteWithHeaders(connection, 405, "", empty, headers[:])
        }
        if path == RegistryPath {
            return List(database, connection)
        }
        start := AppPath.count
        end := path.count
        collectionsOnly := text.TextHasSuffix(path, CollectionPath)
        if collectionsOnly {
            end -= CollectionPath.count
        }
        if end <= start || !identity.ValidNamespace(path[start:end]) {
            return Error(connection, 404, "app not found")
        }
        return Details(database, connection, path[start:end], collectionsOnly)
    }
}
