#if TARGET == .C && OS == .LINUX {
    mutex :: #import "std/mutex_linux";
    numbers :: #import "std/number_text";
    text :: #import "std/text_tools";
    time :: #import "std/timer_linux";
    wire :: #import "wire_text";
    #import "std/byte_text_linux"
    #import "std/vec"

    Request :: struct {
        method: s64
        route: s64
        started: s64
    }

    Series :: struct {
        status: u32
        count: s64
        milliseconds: s64
    }

    Bucket :: struct {
        statuses: Vec(Series)
    }

    // One labelled event count, such as an auth failure's "status|reason".
    Labelled :: struct {
        key: [96]u8
        count: s64
        total: s64
    }

    // The event counts Go's server keeps beside its HTTP counters.
    Events :: struct {
        syncRequests: s64
        syncFailures: s64
        fullSnapshots: s64
        encryptedRecords: s64
        encryptedPayloads: s64
        authFailures: s64
        legacyHints: s64
        webSocketAccepted: s64
        webSocketRejected: s64
        stuckInvoices: s64
        authFailuresBy: Vec(Labelled)
        fullSnapshotsBy: Vec(Labelled)
        webSocketRejects: Vec(Labelled)
    }

    Counters :: struct {
        lock: mutex.Mutex
        buckets: Vec(Bucket)
        events: Events
    }

    #scope_file
    // The server's counters, for the handlers that record events. Open sets
    // it before the listener starts and Close clears it after it stops.
    active: *Counters;

    Methods: [10]string = .["OTHER", "GET", "HEAD", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "TRACE", "CONNECT"];
    Routes: [125]string = .["unmatched", "/healthz", "/readyz", "/metrics", "/api/v1/rates", "/api/v1/node", "/api/v1/node/peers",
        "/api/v1/node/pairing/invites", "/api/v1/node/pairing/accept", "/api/v1/node/pairing/complete",
        "/api/v1/node/mesh/export", "/api/v1/node/mesh/import", "/api/v1/namespaces", "/api/v1/namespaces/claims",
        "/api/v1/namespaces/resolve", "/api/v1/sync", "/api/v1/sync/challenge", "/api/v1/sync/login", "/api/v1/sync/logout",
        "/api/v1/sync/ws", "/api/v1/sync/diagnostics", "/api/v1/account", "/api/v1/account/delete",
        "/api/v1/account/delete-with-key", "/api/v1/account/devices", "/api/v1/account/profile-icon", "/api/v1/account/export",
        "/api/v1/account/backup", "/api/v1/account/passkeys", "/api/v1/account/passkeys/remove", "/api/v1/account-backup/open",
        "/api/v1/account-backup/salt", "/api/v1/account-backup/passkey/open", "/api/v1/account/app-grants",
        "/api/v1/account/app-records", "/api/v1/link/put", "/api/v1/link/get", "/api/v1/link/close", "/api/v1/apps",
        "/api/v1/apps/{app_id}", "/api/v1/apps/{app_id}/collections", "/api/v1/account/app-grants/{id}",
        "/api/v1/blobs/{path}", "/api/v1/packages/{path}", "/api/v2/packages/{path}",
        "/", "/openapi.json", "/api/v1/feedback", "/api/v1/admin/feedback", "/api/v1/admin/feedback/reply",
        "/api/v1/publications", "/api/v1/publications/{id}", "/api/v1/friends", "/api/v1/friends/requests",
        "/api/v1/friends/stats", "/api/v1/friends/{user_id_hash}", "/api/v1/friends/requests/{id}", "/api/v1/profile/stats",
        "/api/v1/chat/completions", "/api/v1/chat/spelling", "/api/v1/chat/habit-icons", "/api/v1/lists",
        "/api/v1/account-backup/methods", "/api/v1/account-backup/google", "/api/v1/account/google", "/api/v1/account/google/remove",
        "/api/v1/lumi/developer", "/api/v1/admin/lumi/developer", "/api/v1/tokens/assets", "/api/v1/tokens/products",
        "/api/v1/tokens/issuer", "/api/v1/tokens/balance", "/api/v1/tokens/ledger", "/api/v1/tokens/activity",
        "/api/v1/tokens/checkpoints/latest", "/api/v1/tokens/receipts/{id}", "/api/v1/tokens/spend",
        "/api/v1/admin/tokens/manual-credit", "/api/v1/admin/tokens/checkpoint", "/api/v1/authorization/requests",
        "/api/v1/authorization/rendezvous", "/api/v1/authorization/cancel", "/api/v1/authorization/claim",
        "/api/v1/authorization/approve", "/api/v1/authorization/revoke", "/api/v1/authorization/challenge",
        "/api/v1/authorization/session", "/api/v1/delegated/sync", "/api/v1/lumi/telegram/link",
        "/api/v1/lumi/telegram/updates", "/api/v1/lumi/telegram/ack", "/api/v1/lumi/telegram/messages",
        "/api/v1/lumi/telegram/webhook", "/api/v1/delegated/ws", "/api/v1/storage/plan", "/api/v1/unlocks",
        "/api/v1/unlocks/grant", "/api/v1/unlocks/products", "/api/v1/tokens/gifts", "/api/v1/rewards",
        "/api/v1/telegram/environment", "/api/v1/telegram/entry", "/api/v1/telegram/entry/verify",
        "/api/v1/telegram/entry/status", "/api/v1/telegram/entry/rendezvous", "/api/v1/telegram/entry/cancel",
        "/api/v1/telegram/account/bind", "/api/v1/account/alias", "/api/v1/account/alias/purchase",
        "/api/v1/rewards/migration", "/api/v1/admin/game-maps", "/api/v1/game-completions", "/api/v1/telegram/launch",
        "/api/v1/tokens/purchases/telegram/catalog", "/api/v1/tokens/purchases/telegram/balance",
        "/api/v1/tokens/purchases/telegram/invoices", "/api/v1/tokens/purchases/telegram/invoices/{id}",
        "/api/v1/tokens/purchases/telegram/invoices/{id}/cancel", "/api/v1/admin/tokens/purchases/telegram/reconcile",
        "/api/v1/tokens/purchases/monero/invoices", "/api/v1/tokens/purchases/monero/invoices/{id}",
        "/api/v1/tokens/purchases/monero/address", "/api/v1/tokens/purchases/monero/address/{reference}",
        "/api/v1/tokens/purchases/monero/deposits", "/api/v1/tokens/purchases/google/verify"];

    Route :: (path: string) -> s64 {
        normalized := path
        if text.TextHasPrefix(path, "/api/v1/apps/") {
            normalized = ifx text.TextHasSuffix(path, "/collections") then "/api/v1/apps/{app_id}/collections" else "/api/v1/apps/{app_id}"
        } else if text.TextHasPrefix(path, "/api/v1/account/app-grants/") {
            normalized = "/api/v1/account/app-grants/{id}"
        } else if text.TextHasPrefix(path, "/api/v1/blobs/") {
            normalized = "/api/v1/blobs/{path}"
        } else if text.TextHasPrefix(path, "/api/v1/packages/") {
            normalized = "/api/v1/packages/{path}"
        } else if text.TextHasPrefix(path, "/api/v2/packages/") {
            normalized = "/api/v2/packages/{path}"
        } else if text.TextHasPrefix(path, "/api/v1/publications/") {
            normalized = "/api/v1/publications/{id}"
        } else if text.TextHasPrefix(path, "/api/v1/tokens/receipts/") {
            normalized = "/api/v1/tokens/receipts/{id}"
        } else if text.TextHasPrefix(path, "/api/v1/tokens/purchases/telegram/invoices/") {
            normalized = "/api/v1/tokens/purchases/telegram/invoices/{id}"
            if text.TextHasSuffix(path, "/cancel") { normalized = "/api/v1/tokens/purchases/telegram/invoices/{id}/cancel" }
        } else if text.TextHasPrefix(path, "/api/v1/tokens/purchases/monero/invoices/") {
            normalized = "/api/v1/tokens/purchases/monero/invoices/{id}"
        } else if text.TextHasPrefix(path, "/api/v1/tokens/purchases/monero/address/") {
            normalized = "/api/v1/tokens/purchases/monero/address/{reference}"
        } else if text.TextHasPrefix(path, "/api/v1/friends/requests/") {
            normalized = "/api/v1/friends/requests/{id}"
        } else if text.TextHasPrefix(path, "/api/v1/friends/") && path != "/api/v1/friends/requests" && path != "/api/v1/friends/stats" {
            normalized = "/api/v1/friends/{user_id_hash}"
        }
        for name, index: Routes {
            if normalized == name { return index }
        }
        return 0
    }

    FindBucket :: (state: *Counters, route: s64, method: s64) -> *Bucket {
        return *state.buckets[route * Methods.count + method]
    }

    Sample :: (output: *Vec(u8), name: string, route: string, method: string, entry: Series, duration: bool) -> bool {
        status: [24]u8
        value: [24]u8
        count := ifx duration then entry.milliseconds else entry.count
        return BuilderAppend(<<output, name) && BuilderAppend(<<output, "{method=\"") &&
            BuilderAppend(<<output, method) && BuilderAppend(<<output, "\",route=\"") &&
            BuilderAppend(<<output, route) && BuilderAppend(<<output, "\",status=\"") &&
            BuilderAppend(<<output, numbers.FormatInteger(cast(s64)entry.status, status[:])) &&
            BuilderAppend(<<output, "\"} ") && BuilderAppend(<<output, numbers.FormatInteger(count, value[:])) &&
            BuilderAppend(<<output, "\n")
    }

    Family :: (state: *Counters, output: *Vec(u8), name: string, duration: bool) -> bool {
        if !BuilderAppend(<<output, "# TYPE ") || !BuilderAppend(<<output, name) ||
            !BuilderAppend(<<output, " counter\n") { return false }
        for route, routeIndex: Routes {
            for method, methodIndex: Methods {
                bucket := FindBucket(state, routeIndex, methodIndex)
                for entry: VecSlice(bucket.statuses, 0, bucket.statuses.count) {
                    if !Sample(output, name, route, method, entry, duration) {
                        return false
                    }
                }
            }
        }
        return true
    }

    SyncRoute :: 15;
    PostMethod :: 3;

    // Byte order, as Go's sort.Strings uses.
    Before :: (left: string, right: string) -> bool {
        shared := ifx left.count < right.count then left.count else right.count
        for index: 0..shared - 1 {
            if left[index] != right[index] { return left[index] < right[index] }
        }
        return left.count < right.count
    }

    KeyText :: (key: []u8) -> string {
        return TextFromBytes(key)
    }

    // Go's metric reason: lower case, every character outside [a-z0-9_.-]
    // becomes "_", and underscores are trimmed from both ends.
    Reason :: (value: string, output: []u8) -> string {
        count: s64 = 0
        for character: value {
            if character >= 128 && character < 192 { continue }
            byte := character
            if byte >= 65 && byte <= 90 { byte += 32 }
            keep := (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 95 || byte == 45 || byte == 46
            if count == output.count { break }
            output[count] = ifx keep then byte else cast(u8)95
            count += 1
        }
        start: s64 = 0
        while start < count && output[start] == 95 { start += 1 }
        while count > start && output[count - 1] == 95 { count -= 1 }
        return TextFromBytes(output[start:count])
    }

    // Adds one to `key` in `entries`, which stay sorted by key as Go prints them.
    Increment :: (entries: *Vec(Labelled), key: string) {
        at: s64 = 0
        while at < entries.count {
            current := KeyText((<<entries)[at].key[:(<<entries)[at].total])
            if current == key {
                (<<entries)[at].count += 1
                return
            }
            if !Before(current, key) { break }
            at += 1
        }
        entry: Labelled
        if key.count > entry.key.count { return }
        for character, index: key { entry.key[index] = character }
        entry.total = key.count
        entry.count = 1
        if !VecPush(<<entries, entry) { return }
        index := entries.count - 1
        while index > at {
            (<<entries)[index] = (<<entries)[index - 1]
            index -= 1
        }
        (<<entries)[at] = entry
    }

    Record :: (counter: s64, amount: s64) {
        state := active
        if state == null || amount <= 0 || !mutex.Lock(*state.lock) { return }
        defer mutex.Unlock(*state.lock)
        events := *state.events
        if counter == 0 { events.encryptedRecords += amount }
        if counter == 1 { events.encryptedPayloads += amount }
        if counter == 2 { events.legacyHints += amount }
        if counter == 3 { events.webSocketAccepted += amount }
        if counter == 4 { events.stuckInvoices += amount }
    }

    RecordLabelled :: (counter: s64, key: string) {
        state := active
        if state == null || !mutex.Lock(*state.lock) { return }
        defer mutex.Unlock(*state.lock)
        events := *state.events
        if counter == 0 {
            events.authFailures += 1
            Increment(*events.authFailuresBy, key)
        }
        if counter == 1 {
            events.fullSnapshots += 1
            Increment(*events.fullSnapshotsBy, key)
        }
        if counter == 2 {
            events.webSocketRejected += 1
            Increment(*events.webSocketRejects, key)
        }
    }

    Scalar :: (output: *Vec(u8), name: string, value: s64) -> bool {
        buffer: [24]u8
        return BuilderAppend(<<output, "# TYPE ") && BuilderAppend(<<output, name) &&
            BuilderAppend(<<output, " counter\n") && BuilderAppend(<<output, name) && BuilderAppend(<<output, " ") &&
            BuilderAppend(<<output, numbers.FormatInteger(value, buffer[:])) && BuilderAppend(<<output, "\n")
    }

    // A family with one label, or with "status" and "reason" when `split`.
    LabelFamily :: (output: *Vec(u8), name: string, label: string, entries: *Vec(Labelled), split: bool) -> bool {
        if !BuilderAppend(<<output, "# TYPE ") || !BuilderAppend(<<output, name) ||
            !BuilderAppend(<<output, " counter\n") { return false }
        for index: 0..entries.count - 1 {
            entry := *(<<entries)[index]
            key := KeyText(entry.key[:entry.total])
            buffer: [24]u8
            if !BuilderAppend(<<output, name) || !BuilderAppend(<<output, "{") { return false }
            if split {
                cut := wire.Cut(key, 124)
                if !BuilderAppend(<<output, "status=\"") || !BuilderAppend(<<output, cut.before) ||
                    !BuilderAppend(<<output, "\",reason=\"") || !BuilderAppend(<<output, cut.after) { return false }
            } else if !BuilderAppend(<<output, label) || !BuilderAppend(<<output, "=\"") || !BuilderAppend(<<output, key) {
                return false
            }
            if !BuilderAppend(<<output, "\"} ") || !BuilderAppend(<<output, numbers.FormatInteger(entry.count, buffer[:])) ||
                !BuilderAppend(<<output, "\n") { return false }
        }
        return true
    }

    Prefixed :: (prefix: string, name: string, output: []u8) -> string {
        count: s64 = 0
        for character: prefix { output[count] = character; count += 1 }
        for character: name { output[count] = character; count += 1 }
        return TextFromBytes(output[:count])
    }

    // The event families under one prefix; Go has no ksync_ stuck invoice count.
    EventFamilies :: (events: *Events, output: *Vec(u8), prefix: string) -> bool {
        name: [64]u8
        return Scalar(output, Prefixed(prefix, "sync_requests_total", name[:]), events.syncRequests) &&
            Scalar(output, Prefixed(prefix, "sync_failures_total", name[:]), events.syncFailures) &&
            Scalar(output, Prefixed(prefix, "sync_full_snapshots_total", name[:]), events.fullSnapshots) &&
            Scalar(output, Prefixed(prefix, "sync_encrypted_records_applied_total", name[:]), events.encryptedRecords) &&
            Scalar(output, Prefixed(prefix, "sync_encrypted_payloads_applied_total", name[:]), events.encryptedPayloads) &&
            Scalar(output, Prefixed(prefix, "auth_failures_total", name[:]), events.authFailures) &&
            Scalar(output, Prefixed(prefix, "legacy_client_hints_total", name[:]), events.legacyHints) &&
            Scalar(output, Prefixed(prefix, "websocket_accepted_total", name[:]), events.webSocketAccepted) &&
            Scalar(output, Prefixed(prefix, "websocket_rejected_total", name[:]), events.webSocketRejected) &&
            (prefix != "mesh_" || Scalar(output, "mesh_monero_stuck_invoices_total", events.stuckInvoices)) &&
            LabelFamily(output, Prefixed(prefix, "auth_failures_by_reason_total", name[:]), "", *events.authFailuresBy, true) &&
            LabelFamily(output, Prefixed(prefix, "sync_full_snapshots_by_reason_total", name[:]), "reason", *events.fullSnapshotsBy, false) &&
            LabelFamily(output, Prefixed(prefix, "websocket_rejected_by_reason_total", name[:]), "reason", *events.webSocketRejects, false)
    }

    #scope_export
    Open :: (state: *Counters) -> bool {
        if !VecResize(state.buckets, Routes.count * Methods.count) {
            return false
        }
        if !mutex.Open(*state.lock) {
            VecFree(state.buckets)
            return false
        }
        active = state
        return true
    }

    Close :: (state: *Counters) {
        if active == state { active = null }
        VecFree(state.buckets)
        VecFree(state.events.authFailuresBy)
        VecFree(state.events.fullSnapshotsBy)
        VecFree(state.events.webSocketRejects)
        unused mutex.Close(*state.lock)
    }

    // Event counts the handlers record, named after Go's counters.
    EncryptedRecordsApplied :: (count: s64) { Record(0, count) }
    EncryptedPayloadApplied :: () { Record(1, 1) }
    LegacyClientHints :: (count: s64) { Record(2, count) }
    WebSocketAccepted :: () { Record(3, 1) }
    MoneroStuckInvoice :: () { Record(4, 1) }

    AuthFailure :: (status: u32, message: string) {
        reason: [96]u8
        key: [104]u8
        digits: [24]u8
        code := numbers.FormatInteger(cast(s64)status, digits[:])
        normalized := Reason(message, reason[:])
        count: s64 = 0
        for character: code { key[count] = character; count += 1 }
        key[count] = 124
        count += 1
        for character: normalized { key[count] = character; count += 1 }
        RecordLabelled(0, TextFromBytes(key[:count]))
    }

    FullSnapshot :: (reason: string) {
        buffer: [96]u8
        normalized := Reason(reason, buffer[:])
        RecordLabelled(1, ifx normalized == "" then "unspecified" else normalized)
    }

    WebSocketRejected :: (reason: string) {
        buffer: [96]u8
        normalized := Reason(reason, buffer[:])
        RecordLabelled(2, ifx normalized == "" then "rejected" else normalized)
    }

    Begin :: (method: string, path: string) -> Request {
        for name, index: Methods {
            if method == name { return .{method = index, route = Route(path), started = time.MonotonicMilliseconds()} }
        }
        return .{route = Route(path), started = time.MonotonicMilliseconds()}
    }

    Finish :: (state: *Counters, request: Request, status: u32) {
        if status < 100 || status > 599 || !mutex.Lock(*state.lock) { return }
        defer mutex.Unlock(*state.lock)
        elapsed := time.MonotonicMilliseconds() - request.started
        if elapsed < 0 { elapsed = 0 }
        if request.route == SyncRoute && request.method == PostMethod {
            // As in Go, a sync that does not answer 200 is a failed sync.
            state.events.syncRequests += 1
            if status != 200 { state.events.syncFailures += 1 }
        }
        bucket := FindBucket(state, request.route, request.method)
        for index: 0..bucket.statuses.count - 1 {
            if bucket.statuses[index].status == status {
                bucket.statuses[index].count += 1
                bucket.statuses[index].milliseconds += elapsed
                return
            }
        }
        entry: Series = .{status = status, count = 1, milliseconds = elapsed}
        unused VecPush(bucket.statuses, entry)
    }

    Report :: (state: *Counters, output: *Vec(u8)) -> bool {
        if !mutex.Lock(*state.lock) { return false }
        defer mutex.Unlock(*state.lock)
        return Family(state, output, "mesh_http_requests_total", false) &&
            Family(state, output, "mesh_http_request_duration_milliseconds_total", true) &&
            Family(state, output, "ksync_http_requests_total", false) &&
            Family(state, output, "ksync_http_request_duration_milliseconds_total", true) &&
            EventFamilies(*state.events, output, "mesh_") && EventFamilies(*state.events, output, "ksync_")
    }
}
