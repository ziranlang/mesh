wire_text :: #import "wire_text";
ascii :: #import "std/text";

ResponseZstdWindowLog :: 20;
MaxZstdWindow :: 8388608;
MaximumHeaderBytes :: 4096;

RequestCoding :: enum {
    Identity
    Gzip
    Zstd
    Unsupported
}

#scope_file

Quality :: (value: string) -> s32 {
    if value == "0" {
        return 0
    }
    if value == "1" {
        return 1000
    }
    if value.count < 2 || value.count > 5 || value[1] != 46 || (value[0] != 48 && value[0] != 49) {
        return -1
    }
    result: s32 = 0
    multiplier: s32 = 100
    for index: cast(s64)2..value.count - 1 {
        digit := value[index]
        if digit < 48 || digit > 57 || (value[0] == 49 && digit != 48) {
            return -1
        }
        result += cast(s32)(digit - 48) * multiplier
        multiplier /= 10
    }
    return ifx value[0] == 49 then 1000 else result
}

EncodingWeights :: struct {
    gzip: s32
    zstd: s32
    identity: s32
    wildcard: s32
}

// An explicit exclusion wins over both another entry and the wildcard.
// Negative values mark codings the header did not name.
RecordWeight :: (weight: *s32, coding: wire_text.CutResult) {
    quality := cast(s32)1000
    if coding.found {
        parameter := wire_text.Cut(wire_text.TrimSpace(coding.after), #char "=")
        if parameter.found && wire_text.MatchesToken(wire_text.TrimSpace(parameter.before), "q") {
            quality = Quality(wire_text.TrimSpace(parameter.after))
        } else {
            quality = 0
        }
        if quality < 0 {
            quality = 0
        }
    }
    if <<weight < 0 || quality < <<weight {
        <<weight = quality
    }
}

ParseWeights :: (header: string) -> EncodingWeights {
    weights: EncodingWeights = .{gzip = -1, zstd = -1, identity = -1, wildcard = -1}
    while header.count > 0 {
        entry := wire_text.Cut(header, #char ",")
        coding := wire_text.Cut(entry.before, #char ";")
        name := wire_text.TrimSpace(coding.before)
        if wire_text.MatchesToken(name, "gzip") {
            RecordWeight(*weights.gzip, coding)
        } else if wire_text.MatchesToken(name, "zstd") {
            RecordWeight(*weights.zstd, coding)
        } else if wire_text.MatchesToken(name, "identity") {
            RecordWeight(*weights.identity, coding)
        } else if name == "*" {
            RecordWeight(*weights.wildcard, coding)
        }
        header = entry.after
    }
    return weights
}

Weight :: (explicit: s32, fallback: s32) -> s32 {
    return ifx explicit >= 0 then explicit else fallback
}

#scope_export
// Content-Encoding accepts exactly one supported coding and no parameters.
Request :: (header: string) -> RequestCoding {
    value := wire_text.TrimSpace(header)
    if value.count == 0 || (value.count == 8 && ascii.StartsWithFoldASCII(value, "identity")) {
        return .Identity
    }
    if value.count == 4 {
        if ascii.StartsWithFoldASCII(value, "gzip") { return .Gzip }
        if ascii.StartsWithFoldASCII(value, "zstd") { return .Zstd }
    }
    return .Unsupported
}

// Empty means no acceptable representation. Identity is the fallback unless
// explicitly preferred; an explicit exclusion overrides wildcard acceptance.
Select :: (header: string, zstd_enabled: bool) -> string {
    if header.count > MaximumHeaderBytes {
        return ""
    }
    weights := ParseWeights(header)
    gzip_quality := Weight(weights.gzip, weights.wildcard)
    zstd_quality := Weight(weights.zstd, weights.wildcard)
    if !zstd_enabled {
        zstd_quality = 0
    }
    selected := "identity"
    quality: s32 = 0
    if gzip_quality > 0 {
        selected = "gzip"
        quality = gzip_quality
    }
    if zstd_quality > 0 && zstd_quality >= quality {
        selected = "zstd"
        quality = zstd_quality
    }
    if weights.identity > quality {
        return "identity"
    }
    if quality == 0 && (weights.identity == 0 || (weights.identity < 0 && weights.wildcard == 0)) {
        return ""
    }
    return selected
}

AcceptsGzip :: (header: string) -> bool {
    if header.count > MaximumHeaderBytes {
        return false
    }
    weights := ParseWeights(header)
    return Weight(weights.gzip, weights.wildcard) > 0
}

AcceptsIdentity :: (header: string) -> bool {
    if header.count > MaximumHeaderBytes {
        return false
    }
    weights := ParseWeights(header)
    return Weight(weights.identity, ifx weights.wildcard == 0 then 0 else 1000) > 0
}
