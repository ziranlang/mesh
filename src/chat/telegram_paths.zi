{
  "/api/v1/lumi/telegram/link": {
    "post": {
      "summary": "Create a one-use Lumi Telegram account link",
      "description": "Authenticated account only. The link expires after ten minutes. Account signing keys stay in the app.",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Bot deep link"
        },
        "401": {
          "description": "Sign in required"
        },
        "503": {
          "description": "Bot unavailable"
        }
      }
    },
    "delete": {
      "summary": "Disconnect the account's Telegram chat",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Disconnected"
        },
        "401": {
          "description": "Sign in required"
        }
      }
    }
  },
  "/api/v1/lumi/telegram/updates": {
    "get": {
      "summary": "Claim the next app action or owner feedback message",
      "description": "Requires a stable 64-character app client identifier. Each update belongs to one executor. Owner feedback is restricted to the configured immutable account ID.",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "parameters": [
        {
          "name": "client",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Link status and next claimed update"
        },
        "400": {
          "description": "Invalid client"
        },
        "401": {
          "description": "Sign in required"
        }
      }
    }
  },
  "/api/v1/lumi/telegram/ack": {
    "post": {
      "summary": "Acknowledge an action claimed by this app client",
      "description": "An optional reply sends the final answer to the originating private Telegram message once. It requires the original account and claiming client. A 202 acknowledgement records that delivery could not be confirmed and prevents automatic replay.",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Acknowledged. Any requested reply has a delivery receipt"
        },
        "202": {
          "description": "Acknowledged. Telegram delivery is unconfirmed"
        },
        "409": {
          "description": "No matching private Telegram message claim"
        },
        "400": {
          "description": "Invalid receipt"
        },
        "401": {
          "description": "Sign in required"
        }
      }
    }
  },
  "/api/v1/lumi/telegram/messages": {
    "post": {
      "summary": "Acknowledge a legacy Lumi conversation upload without sending to Telegram",
      "description": "Authenticated history uploads from older apps drain silently, including stale history and previous uncertain deliveries. Conversation history remains in encrypted account sync. No Telegram text, actions or notifications are sent.",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
