    entitlement_rules :: #import "entitlement_rules_native";
    entitlements :: #import "entitlements_http_native";
    authorizations :: #import "authorization_http_native";
    delegated :: #import "delegated_sync_native";
    docs :: #import "docs_native";
    grants :: #import "app_grant_http_native";
