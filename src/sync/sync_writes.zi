#import "std/go_types"
#import "protocol"
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
state :: #import "account_state";
timestamp :: #import "timestamp";
typed_queries :: #import "typed_write_queries";
record_queries :: #import "record_write_queries";
clock :: #import "std/time_go";
scope :: #import "scope";
native :: #system_library "go:database/sql";
builtin :: #system_library "go:builtin";

#scope_file
CollectionNamesResult :: struct {
    value: []string
    error: Error
}
AllocateStrings :: (count: isize) -> []string #foreign builtin "make";
AppendString :: (values: []string, value: string) -> []string #foreign builtin "append";
CloseRowsAtReturn :: (rows: *sql.Rows) #go_defer #foreign native "(*Rows).Close";

ReadCollections :: (rows: *sql.Rows) -> CollectionNamesResult {
    result: CollectionNamesResult
    CloseRowsAtReturn(rows)
    values := AllocateStrings(cast(isize)0)
    while sql.Next(rows) {
        value: string
        destinations: [1]Any = .[*value]
        result.error = sql.ScanRows(rows, destinations[:])
        if result.error != null {
            return result
        }
        values = AppendString(values, value)
    }
    result.error = sql.RowsError(rows)
    if result.error == null {
        result.value = values
    }
    return result
}

#scope_export
SyncWriteResult :: struct {
    applied: isize
    error: Error
}

// A full re-sync replaces only the calling app's data. Released Inbe clients
// send no app_id; Inbe owns the typed tables, the whole-sync envelopes and the
// account-wide records. Any other app clears only its own collections.
ReplaceData :: (transaction: *sql.Transaction, context: ctx.Context, userID: string, appID: string) -> Error {
    owner := appID
    if owner == "" {
        owner = "inbe"
    }
    arguments: [1]Any = .[userID]
    if owner == "inbe" {
        queries: [7]string = .[
            "DELETE FROM server_session_rounds WHERE user_id_hash=?1",
            "DELETE FROM server_sessions WHERE user_id_hash=?1",
            "DELETE FROM server_habit_days WHERE user_id_hash=?1",
            "DELETE FROM server_habits WHERE user_id_hash=?1",
            "DELETE FROM server_meditation_logs WHERE user_id_hash=?1",
            "DELETE FROM server_social_snapshots WHERE user_id_hash=?1",
            "DELETE FROM server_encrypted_payloads WHERE user_id_hash=?1",
        ]
        for query: queries {
            removed := sql.ExecTx(transaction, context, query, arguments[:])
            if removed.error != null {
                return removed.error
            }
        }
    }
    queried := sql.QueryTx(transaction, context,
        "SELECT DISTINCT collection FROM server_encrypted_records WHERE user_id_hash=?1", arguments[:])
    if queried.error != null {
        return queried.error
    }
    collections := ReadCollections(queried.value)
    if collections.error != null {
        return collections.error
    }
    for collection: collections.value {
        collectionOwner := scope.CollectionOwnerApp(collection)
        replaced := collectionOwner == owner || (collectionOwner == "" && owner == "inbe")
        if !replaced {
            continue
        }
        values: [2]Any = .[userID, collection]
        removed := sql.ExecTx(transaction, context,
            "DELETE FROM server_encrypted_records WHERE user_id_hash=?1 AND collection=?2", values[:])
        if removed.error != null {
            return removed.error
        }
    }
    version := state.NextVersion(transaction, context, userID)
    return version.error
}

UpsertSession :: (transaction: *sql.Transaction, context: ctx.Context, userID: string, session: Session) -> SyncWriteResult {
    result: SyncWriteResult
    version := state.NextVersion(transaction, context, userID)
    result.error = version.error
    if result.error != null {
        return result
    }
    arguments: [17]Any = .[
        userID, session.ID, timestamp.NormalizeTime(session.StartedAt, ""), session.LocalDate,
        session.Topic, session.Activity, session.Source, session.RoundsHash, session.MoodBefore,
        session.MoodAfter, session.Energy, session.Stress, session.Note, session.Tags,
        session.DeletedAt, timestamp.NormalizeTime(session.UpdatedAt, ""), version.value,
    ]
    written := sql.ExecTx(transaction, context,
        typed_queries.UpsertSession, arguments[:])
    result.error = written.error
    if result.error != null {
        return result
    }
    applied := state.Affected(written.value)
    if applied == cast(isize)0 || session.Rounds.count == 0 {
        result.applied = applied
        return result
    }
    identifiers: [2]Any = .[userID, session.ID]
    cleared := sql.ExecTx(transaction, context,
        "DELETE FROM server_session_rounds WHERE user_id_hash=?1 AND session_id=?2", identifiers[:])
    result.error = cleared.error
    if result.error != null {
        return result
    }
    for round: session.Rounds {
        values: [5]Any = .[userID, session.ID, round.RoundIndex, round.Breaths, round.HoldSeconds]
        inserted := sql.ExecTx(transaction, context,
            typed_queries.InsertRound, values[:])
        result.error = inserted.error
        if result.error != null {
            return result
        }
    }
    result.applied = applied
    return result
}

UpsertRecord :: (transaction: *sql.Transaction, context: ctx.Context, userID: string, item: EncryptedRecord) -> SyncWriteResult {
    result: SyncWriteResult
    version := state.NextVersion(transaction, context, userID)
    result.error = version.error
    if result.error != null {
        return result
    }
    now := clock.Now()
    arguments: [14]Any = .[
        userID, item.Collection, item.ID, item.KeyID, item.Nonce, item.Ciphertext,
        timestamp.NormalizeWriteTime(item.UpdatedAt, now), item.DeletedAt, item.ContentHash,
    item.SchemaVersion, item.ParentID, version.value, timestamp.WriteTimeLimit(now), item.FreeBytes,
    ]
    written := sql.ExecTx(transaction, context,
        record_queries.Upsert, arguments[:])
    result.error = written.error
    if result.error == null {
        result.applied = state.Affected(written.value)
    }
    return result
}

DeleteHabit :: (transaction: *sql.Transaction, context: ctx.Context, userID: string, habit: Habit) -> SyncWriteResult {
    result: SyncWriteResult
    updatedAt := timestamp.NormalizeTime(habit.UpdatedAt, "")
    arguments: [3]Any = .[userID, habit.ID, updatedAt]
    removed := sql.ExecTx(transaction, context,
        typed_queries.DeleteHabit, arguments[:])
    result.error = removed.error
    if result.error != null {
        return result
    }
    applied := state.Affected(removed.value)
    if applied == cast(isize)0 {
        return result
    }
    identifiers: [2]Any = .[userID, habit.ID]
    children := sql.ExecTx(transaction, context,
        typed_queries.DeleteHabitDays, identifiers[:])
    result.error = children.error
    if result.error != null {
        return result
    }
    applied += state.Affected(children.value)
    version := state.NextVersion(transaction, context, userID)
    result.error = version.error
    if result.error == null {
        result.applied = applied
    }
    return result
}

DeleteHabitDay :: (transaction: *sql.Transaction, context: ctx.Context, userID: string, day: HabitDay) -> SyncWriteResult {
    result: SyncWriteResult
    updatedAt := timestamp.NormalizeTime(day.UpdatedAt, "")
    arguments: [4]Any = .[userID, day.HabitID, day.LocalDate, updatedAt]
    removed := sql.ExecTx(transaction, context,
        typed_queries.DeleteHabitDay, arguments[:])
    result.error = removed.error
    if result.error != null {
        return result
    }
    applied := state.Affected(removed.value)
    if applied == cast(isize)0 {
        return result
    }
    version := state.NextVersion(transaction, context, userID)
    result.error = version.error
    if result.error == null {
        result.applied = applied
    }
    return result
}

DeleteSession :: (transaction: *sql.Transaction, context: ctx.Context, userID: string, session: Session) -> SyncWriteResult {
    result: SyncWriteResult
    updatedAt := timestamp.NormalizeTime(session.UpdatedAt, session.StartedAt)
    arguments: [3]Any = .[userID, session.ID, updatedAt]
    removed := sql.ExecTx(transaction, context,
        typed_queries.DeleteSession, arguments[:])
    result.error = removed.error
    if result.error != null {
        return result
    }
    applied := state.Affected(removed.value)
    if applied == cast(isize)0 {
        return result
    }
    identifiers: [2]Any = .[userID, session.ID]
    children := sql.ExecTx(transaction, context,
        typed_queries.DeleteSessionRounds, identifiers[:])
    result.error = children.error
    if result.error != null {
        return result
    }
    applied += state.Affected(children.value)
    version := state.NextVersion(transaction, context, userID)
    result.error = version.error
    if result.error == null {
        result.applied = applied
    }
    return result
}

CompletedValue :: (completed: bool) -> isize {
    if completed {
        return cast(isize)1
    }
    return cast(isize)0
}

NormalizedDayCount :: (day: HabitDay) -> isize {
    if !day.Completed {
        return cast(isize)0
    }
    if day.Count > cast(isize)0 {
        return day.Count
    }
    return cast(isize)1
}

UpsertMeditation :: (transaction: *sql.Transaction, context: ctx.Context, userID: string,
    item: MeditationLog) -> SyncWriteResult {
    result: SyncWriteResult
    version := state.NextVersion(transaction, context, userID)
    result.error = version.error
    if result.error != null {
        return result
    }
    arguments: [6]Any = .[userID, item.ID, item.SessionID, item.DurationSeconds,
        timestamp.NormalizeTime(item.CompletedAt, item.Timestamp), version.value]
    written := sql.ExecTx(transaction, context,
        typed_queries.UpsertMeditation, arguments[:])
    result.error = written.error
    if result.error == null {
        result.applied = state.Affected(written.value)
    }
    return result
}

#scope_file
WriteHabit :: (transaction: *sql.Transaction, context: ctx.Context, userID: string,
    habit: Habit, query: string) -> SyncWriteResult {
    result: SyncWriteResult
    version := state.NextVersion(transaction, context, userID)
    result.error = version.error
    if result.error != null {
        return result
    }
    arguments: [13]Any = .[userID, habit.ID, habit.Name, habit.ColorR, habit.ColorG,
        habit.ColorB, habit.SyncMode, habit.SyncActivity, habit.CounterEnabled,
        habit.SortOrder, habit.DeletedAt, timestamp.NormalizeTime(habit.UpdatedAt, ""), version.value]
    written := sql.ExecTx(transaction, context, query, arguments[:])
    result.error = written.error
    if result.error == null {
        result.applied = state.Affected(written.value)
    }
    return result
}

WriteDay :: (transaction: *sql.Transaction, context: ctx.Context, userID: string,
    day: HabitDay, query: string) -> SyncWriteResult {
    result: SyncWriteResult
    version := state.NextVersion(transaction, context, userID)
    result.error = version.error
    if result.error != null {
        return result
    }
    arguments: [7]Any = .[userID, day.HabitID, day.LocalDate, CompletedValue(day.Completed),
        NormalizedDayCount(day), timestamp.NormalizeTime(day.UpdatedAt, ""), version.value]
    written := sql.ExecTx(transaction, context, query, arguments[:])
    result.error = written.error
    if result.error == null {
        result.applied = state.Affected(written.value)
    }
    return result
}

#scope_export
UpsertHabit :: (transaction: *sql.Transaction, context: ctx.Context, userID: string,
    habit: Habit) -> SyncWriteResult {
    return WriteHabit(transaction, context, userID, habit,
        typed_queries.UpsertHabit)
}

UpsertHabitOp :: (transaction: *sql.Transaction, context: ctx.Context, userID: string,
    habit: Habit) -> SyncWriteResult {
    return WriteHabit(transaction, context, userID, habit,
        typed_queries.UpsertHabitOp)
}

UpsertDay :: (transaction: *sql.Transaction, context: ctx.Context, userID: string,
    day: HabitDay) -> SyncWriteResult {
    return WriteDay(transaction, context, userID, day,
        typed_queries.UpsertDay)
}

UpsertDayOp :: (transaction: *sql.Transaction, context: ctx.Context, userID: string,
    day: HabitDay) -> SyncWriteResult {
    return WriteDay(transaction, context, userID, day,
        typed_queries.UpsertDayOp)
}
