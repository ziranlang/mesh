[Unit]
Description=Delete Mesh deploy backups older than 28 days
# Deleted accounts and data must be gone everywhere within 30 days: a daily
# run that removes copies 28 days old keeps every backup inside that window.
ConditionPathIsDirectory=/var/lib/mesh/backups

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'if [ -d /var/lib/daochi/backups ]; then find /var/lib/daochi/backups -type f \( -name "daochi.pre-upgrade.*" -o -name "daochi.db.*" -o -name "daochi.env.*" \) -mtime +27 -delete; fi'
ExecStart=/usr/bin/find /var/lib/mesh/backups -type f ( -name mesh.pre-upgrade.* -o -name mesh.db.* -o -name mesh.env.* ) -mtime +27 -delete
