#import "std/go_types"
support :: #import "bench_support";
codecs :: #import "bench_codecs";
io :: #import "std/io_go";
clock :: #import "std/time_go";
json :: #import "std/json_go";
fmt :: #system_library "go:fmt";
builtin :: #system_library "go:builtin";

#scope_file
Corpus :: struct {
    Name: string #go_tag "json:\"name\""
    Kind: string #go_tag "json:\"kind\""
    Path: string #go_tag "json:\"path\""
}
Timing :: struct {
    Median: float64 #go_tag "json:\"median_ms\""
    P95: float64 #go_tag "json:\"p95_ms\""
    Samples: s64 #go_tag "json:\"samples\""
    Allocated: float64 #go_tag "json:\"allocated_bytes_per_op\""
    Allocations: float64 #go_tag "json:\"allocations_per_op\""
}
Row :: struct {
    Corpus: string #go_tag "json:\"corpus\""
    Kind: string #go_tag "json:\"kind\""
    Codec: string #go_tag "json:\"codec\""
    Level: isize #go_tag "json:\"level\""
    Input: s64 #go_tag "json:\"input_bytes\""
    Compressed: s64 #go_tag "json:\"compressed_bytes\""
    Encode: Timing #go_tag "json:\"encode\""
    Decode: Timing #go_tag "json:\"decode\""
    Roundtrip: bool #go_tag "json:\"roundtrip\""
}
Report :: struct {
    Go: string #go_tag "json:\"go\""
    ZstdModule: string #go_tag "json:\"zstd_module\""
    BrotliModule: string #go_tag "json:\"brotli_module\""
    ZstdWindow: isize #go_tag "json:\"zstd_window_bytes\""
    Results: []Row #go_tag "json:\"results\""
}
Case :: struct {
    profile: codecs.Profile
    input: []u8
    encoded: []u8
    output: support.Buffer
    encoder: codecs.Encoder
}
AppendRow :: (rows: []Row, row: Row) -> []Row #foreign builtin "append";
FrameName :: (format: string, name: string, level: isize, mode: string) -> string #foreign fmt "Sprintf";
CodecName :: (format: string, name: string, mode: string) -> string #foreign fmt "Sprintf";

Encode :: (run: *Case) -> []u8 {
    support.ResetBuffer(*run.output)
    output := cast(io.Writer)*run.output
    if run.profile.reuse && codecs.Ready(*run.encoder) {
        codecs.Reset(*run.encoder, output)
    } else {
        run.encoder = codecs.New(run.profile, output)
    }
    codecs.Encode(*run.encoder, run.input, run.profile.encoding != "gzip")
    return support.BufferBytes(*run.output)
}
Decode :: (run: *Case) -> []u8 {
    return codecs.Decode(run.profile.encoding, run.encoded)
}
Operation :: #type (run: *Case) -> []u8;
Measure :: (run: *Case, operation: Operation) -> Timing {
    unused operation(run)
    support.GC()
    samples := support.NewTimes(cast(isize)0, cast(isize)2000)
    before: support.MemStats
    after: support.MemStats
    support.ReadMemStats(*before)
    start := clock.Now()
    while samples.count < 9 || (samples.count < 2000 && support.Nanos(support.Elapsed(start)) < 45000000) {
        at := clock.Now()
        result := operation(run)
        samples = support.AppendTime(samples, support.ElapsedMS(at))
        support.KeepAlive(cast(Any)result)
    }
    support.ReadMemStats(*after)
    support.SortTimes(samples)
    count := samples.count
    p95 := cast(s64)(cast(float64)count * 0.95)
    return .{Median = samples[count / 2], P95 = samples[p95], Samples = count,
        Allocated = cast(float64)(support.Allocated(*after) - support.Allocated(*before)) / cast(float64)count,
        Allocations = cast(float64)(support.Allocations(*after) - support.Allocations(*before)) / cast(float64)count}
}

RunCase :: (out: string, item: Corpus, data: []u8, name: string, profile: codecs.Profile) -> Row {
    run: Case = .{profile = profile, input = data}
    run.encoded = support.Clone(Encode(*run))
    if !support.Equal(Decode(*run), data) { support.Fail("codec roundtrip mismatch") }
    mode := ifx profile.reuse then "reuse" else "fresh"
    if profile.encoding != "gzip" {
        dir := support.Join(support.Join(out, "cross-decode"), item.Name)
        support.Check(support.MkdirAll(dir, cast(support.FileMode)493))
        file := support.Join(dir, FrameName("%s-%d-%s.bin", name, profile.level, mode))
        support.Check(support.WriteBytes(file, run.encoded, cast(support.FileMode)420))
    }
    return .{Corpus = item.Name, Kind = item.Kind, Codec = CodecName("%s-%s", name, mode), Level = profile.level,
        Input = data.count, Compressed = run.encoded.count,
        Encode = Measure(*run, Encode), Decode = Measure(*run, Decode), Roundtrip = true}
}

#scope_export
Run :: (out: string) {
    corpora: []Corpus
    support.Check(json.Unmarshal(support.Read(support.Join(out, "corpus.json")), cast(Any)*corpora))
    rows: []Row
    gzip_levels: [4]isize = .[1, 3, 6, 9]
    zstd_levels: [4]isize = .[1, 3, 7, 11]
    brotli_levels: [3]isize = .[1, 4, 6]
    choices: [2]bool = .[false, true]
    for item: corpora {
        data := support.Read(item.Path)
        for level: gzip_levels {
            for reuse: choices {
                profile: codecs.Profile = .{encoding = "gzip", level = level, reuse = reuse}
                rows = AppendRow(rows, RunCase(out, item, data, "gzip-go", profile))
            }
        }
        for level: zstd_levels {
            for entropy: choices {
                name := ifx entropy then "zstd-go-entropy" else "zstd-go"
                for reuse: choices {
                    profile: codecs.Profile = .{encoding = "zstd", level = level, reuse = reuse, entropy = entropy}
                    rows = AppendRow(rows, RunCase(out, item, data, name, profile))
                }
            }
        }
        for level: brotli_levels {
            for reuse: choices {
                profile: codecs.Profile = .{encoding = "br", level = level, reuse = reuse}
                rows = AppendRow(rows, RunCase(out, item, data, "brotli-go", profile))
            }
        }
        support.PrintProgress("Codec benchmark completed", item.Name)
    }
    report: Report = .{Go = support.Version(), ZstdModule = "github.com/klauspost/compress@v1.20.3",
        BrotliModule = "github.com/andybalholm/brotli@v1.2.4", ZstdWindow = 1048576, Results = rows}
    support.WriteJSON(out, "go-results.json", cast(Any)report)
}
